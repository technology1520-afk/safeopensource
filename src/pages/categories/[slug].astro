---
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { categories } from '../../data/categories';
import { getToolsByCategory } from '../../utils/tools';
import type { CategoryData } from '../../types/tool';

export async function getStaticPaths() {
  return categories.map((cat) => ({
    params: { slug: cat.slug },
    props: { category: cat }
  }));
}

interface Props {
  category: CategoryData;
}

const { category } = Astro.props;
const tools = getToolsByCategory(category.slug);

const avgScore = tools.length > 0
  ? Math.round(tools.reduce((acc, t) => acc + t.safety_score, 0) / tools.length)
  : 0;
---

<Layout
  title={`Best Open Source ${category.name} Tools — Safety Scores & Audits | SafeOpenSource`}
  description={`Comprehensive directory of the best open-source ${category.name.toLowerCase()} software. Evaluated with independent 0-100 Safety Scores, supply-chain checks, and license permissions.`}
>
  <!-- Breadcrumbs -->
  <nav class="flex items-center gap-2 text-xs font-mono text-app-subtle mb-6" aria-label="Breadcrumb">
    <a href="/" class="hover:text-app-text">Home</a>
    <span>/</span>
    <a href="/#categories" class="hover:text-app-text">Categories</a>
    <span>/</span>
    <span class="text-app-text font-medium">{category.name}</span>
  </nav>

  <!-- Category Header -->
  <header class="rounded-2xl border border-app-border bg-app-surface p-6 sm:p-8 mb-8">
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-6">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-blue-500/30 bg-blue-950/30 text-blue-400 text-micro mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
          <span>Category Directory</span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-extrabold text-app-text tracking-tight mb-3">
          Best Open Source {category.name}
        </h1>

        <!-- Handcrafted non-templated 2-3 sentence intro -->
        <p class="text-sm sm:text-base text-app-muted leading-relaxed mb-6">
          {category.intro}
        </p>
      </div>

      <!-- Category summary badge -->
      <div class="shrink-0 flex sm:flex-col items-center justify-between sm:justify-center p-4 sm:p-5 rounded-xl bg-app-bg border border-app-border gap-2">
        <div class="text-center">
          <span class="text-micro text-app-subtle block">Tools Evaluated</span>
          <span class="font-mono font-bold text-xl text-app-text">{tools.length}</span>
        </div>
        <div class="text-center pt-2 sm:border-t border-app-border">
          <span class="text-micro text-app-subtle block">Category Avg</span>
          <span class="font-mono font-bold text-xl text-emerald-400">
            {avgScore}<span class="text-app-subtle text-xs font-normal">/100</span>
          </span>
        </div>
      </div>
    </div>
  </header>

  <!-- Special AI Agents Sector Safety Advisory & Guide Callout -->
  {category.slug === 'ai-agents' && (
    <div class="mb-8 p-5 rounded-2xl border border-caution-border bg-caution-soft text-app-text shadow-xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-caution animate-ping"></span>
            <span class="font-mono text-xs font-bold uppercase tracking-wider text-caution">
              HIGH-PRIVILEGE SECTOR NOTICE
            </span>
          </div>
          <p class="text-xs sm:text-sm text-app-text font-sans leading-relaxed max-w-2xl">
            Autonomous AI agents execute shell commands with local operator credentials. To reflect this host-level risk, SafeOpenSource weights <strong class="text-app-text font-bold">Security Health at 55%</strong> for all tools in this category.
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0 font-mono text-xs">
          <a
            href="/how-we-score"
            class="text-caution hover:underline font-semibold"
          >
            Why 55% Weight?
          </a>
          <a
            href="/how-to-run-an-ai-agent-safely"
            class="px-3.5 py-2 rounded-lg bg-amber-600 hover:bg-amber-500 text-white font-bold inline-flex items-center gap-1.5 transition-colors shadow-xs"
          >
            Run Agents Safely Guide →
          </a>
        </div>
      </div>
    </div>
  )}

  <!-- Reserved Zero-CLS AdSlot Container -->
  <section class="my-6">
    <AdSlot format="leaderboard" />
  </section>

  <!-- Tools Grid Sorted by Safety Score -->
  <section class="my-8">
    <div class="flex items-center justify-between gap-4 mb-6">
      <div>
        <span class="text-micro text-app-subtle block mb-1">Ranked Directory</span>
        <h2 class="text-lg sm:text-xl font-bold text-app-text">
          Evaluated Tools (Sorted by Safety Score)
        </h2>
      </div>
      <span class="text-xs font-mono text-app-subtle">
        Score Range: {tools[tools.length - 1]?.safety_score} - {tools[0]?.safety_score}
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {tools.map((tool) => (
        <ToolCard tool={tool} />
      ))}
    </div>
  </section>

  <!-- Category Comparisons Strip if multiple tools exist -->
  {tools.length >= 2 && (
    <section class="my-12 pt-8 border-t border-app-border">
      <div class="mb-4">
        <span class="text-micro text-blue-400 block mb-1">Head-to-Head</span>
        <h2 class="text-base sm:text-lg font-bold text-app-text">
          Popular Comparisons in {category.name}
        </h2>
      </div>

      <div class="flex flex-wrap gap-3">
        {tools.slice(0, 3).map((toolA, idx) =>
          tools.slice(idx + 1, idx + 3).map((toolB) => (
            <a
              href={`/alternatives/${toolA.slug}-vs-${toolB.slug}`}
              class="px-3.5 py-2 rounded-lg border border-app-border bg-app-surface hover:bg-app-surface-hover hover:border-blue-500/40 text-xs font-mono text-app-muted hover:text-app-text transition-colors flex items-center gap-2"
            >
              <span>{toolA.name}</span>
              <span class="text-blue-400 font-bold">vs</span>
              <span>{toolB.name}</span>
              <span class="text-app-subtle text-[11px]">&rarr;</span>
            </a>
          ))
        )}
      </div>
    </section>
  )}
</Layout>

