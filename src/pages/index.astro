---
import Layout from '../layouts/Layout.astro';
import LiveScanConsole from '../components/LiveScanConsole.astro';
import FlagWall from '../components/FlagWall.astro';
import CategoryRadar from '../components/CategoryRadar.astro';
import BentoRow from '../components/BentoRow.astro';
import CategoryCard from '../components/CategoryCard.astro';
import AdSlot from '../components/AdSlot.astro';
import TrustBand from '../components/TrustBand.astro';
import TopRepos from '../components/TopRepos.astro';
import TrendingRepos from '../components/TrendingRepos.astro';
import StackBundles from '../components/StackBundles.astro';
import MatchQuiz from '../components/MatchQuiz.astro';
import { categories } from '../data/categories';
import { getAllTools, getSafestTools, getToolsByCategory } from '../utils/tools';

const allTools = getAllTools();
const safestTools = getSafestTools(3);

// Category stats
const categoriesWithStats = categories.map((cat) => {
  const tools = getToolsByCategory(cat.slug);
  const avgScore = tools.length > 0
    ? tools.reduce((acc, t) => acc + t.safety_score, 0) / tools.length
    : 0;
  return {
    ...cat,
    toolCount: tools.length,
    avgScore
  };
});
---

<Layout
  title="SafeOpenSource — Live Open-Source Security Operations Console"
  description="Continuous security scans for open-source tools with objective 0–100 Safety Scores. We watch repositories so you don't get burned."
>
  <!-- Hero Section: Security Ops Center Console -->
  <section class="py-6 sm:py-12 max-w-4xl mx-auto text-center">
    <!-- Headline and Core Mission Statement -->
    <div class="max-w-3xl mx-auto mb-8">
      <div class="inline-flex items-center gap-2 text-micro text-emerald-400 font-mono mb-3 px-3 py-1 rounded-full border border-emerald-500/30 bg-emerald-950/20">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>SECURITY OPS CENTER :: CONTINUOUS REPO TELEMETRY</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-app-text leading-tight mb-4">
        We watch these projects so you don't get <span class="text-rose-400">burned</span>.
      </h1>

      <p class="text-sm sm:text-base text-app-muted leading-relaxed mb-6 max-w-2xl mx-auto font-sans">
        Not a software directory. A live mission-control station monitoring open-source software with verifiable 0–100 Safety Scores, OpenSSF Scorecards, and incident alerts.
      </p>

      <!-- Real-Time On-Demand Scanner Input Box -->
      <form action="/scan" method="GET" class="w-full max-w-xl mx-auto mb-4">
        <div class="flex flex-col sm:flex-row items-stretch gap-2 p-1.5 rounded-2xl border border-app-border bg-[#0e1014] shadow-xl">
          <div class="relative flex-1">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-zinc-500">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              </svg>
            </div>
            <input
              type="text"
              name="url"
              required
              placeholder="Paste any GitHub repository (e.g. github.com/owner/repo)"
              class="w-full pl-10 pr-3 py-2.5 rounded-xl bg-black/40 text-white placeholder-zinc-500 text-xs font-mono focus:outline-none focus:ring-1 focus:ring-blue-500 border border-transparent"
              autocomplete="off"
              spellcheck="false"
            />
          </div>
          <button
            type="submit"
            class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 active:bg-blue-700 text-white font-mono text-xs font-bold transition-colors shrink-0 flex items-center justify-center gap-1.5 cursor-pointer shadow-xs"
          >
            <span>Scan Any Repo</span>
            <span>&rarr;</span>
          </button>
        </div>

        <div class="flex items-center justify-center gap-2 mt-2 font-mono text-[11px] text-app-subtle">
          <span>Popular:</span>
          <a href="/scan?url=jellyfin/jellyfin" class="text-zinc-400 hover:text-white underline">jellyfin</a>
          <span>&middot;</span>
          <a href="/scan?url=dani-garcia/vaultwarden" class="text-zinc-400 hover:text-white underline">vaultwarden</a>
          <span>&middot;</span>
          <a href="/scan?url=louislam/uptime-kuma" class="text-zinc-400 hover:text-white underline">uptime-kuma</a>
        </div>
      </form>
    </div>

    <!-- Live Telemetry Monitor (Real Data Strip) -->
    <div class="block mb-8">
      <LiveScanConsole />
    </div>
  </section>

  <!-- Global High-Credibility Trust Band -->
  <TrustBand class="my-6" />

  <!-- 1. Top Ranked Repositories Leaderboard -->
  <TopRepos tools={allTools} activeSort="score" />

  <!-- 2. Momentum & Velocity Telemetry -->
  <TrendingRepos activeFilter="velocity" />

  <!-- Reserved Zero-CLS AdSlot Container -->
  <section class="my-6">
    <AdSlot format="leaderboard" />
  </section>

  <!-- 3. The Flag Wall (Incident Feed Section) -->
  <FlagWall />

  <!-- 4. Category Radar (13 Sectors SVG Grid) -->
  <CategoryRadar />

  <!-- 5. "The Right Stack for You" Recommendation Bundles -->
  <StackBundles />

  <!-- 6. 3-Question Architecture Matcher Quiz -->
  <MatchQuiz />

  <!-- 7. Safest This Month Bento Grid -->
  <section class="my-14">
    <div class="flex items-center justify-between gap-4 mb-6">
      <div>
        <span class="text-micro text-emerald-400 block mb-1">VERIFIED HEALTHY</span>
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-app-text">
          Safest Tools This Month
        </h2>
      </div>
      <a href="/categories/monitoring-status" class="text-xs font-mono text-app-subtle hover:text-blue-400 transition-colors hidden sm:inline-block">
        Explore Healthy Stacks &rarr;
      </a>
    </div>

    <BentoRow tools={safestTools} />
  </section>

  <!-- How Scoring Works Strip -->
  <section class="my-14 rounded-2xl border border-app-border bg-app-surface p-6 sm:p-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="max-w-xl">
        <span class="text-micro text-blue-400 block mb-1">OBJECTIVE TELEMETRY</span>
        <h2 class="text-lg sm:text-xl font-bold text-app-text mb-2">
          Deterministic 0–100 Scoring Weights
        </h2>
        <p class="text-xs text-app-muted leading-relaxed">
          Scores are derived mathematically from four weighted dimensions: Security Health (35%), Maintenance Cadence (30%), Community Velocity (20%), and Release Hygiene (15%). No vendor can pay for higher scores.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <div class="px-3 py-2 rounded-lg bg-app-bg border border-app-border text-center">
          <div class="font-mono font-bold text-xs text-emerald-400">35%</div>
          <div class="text-[10px] text-app-subtle">Security</div>
        </div>
        <div class="px-3 py-2 rounded-lg bg-app-bg border border-app-border text-center">
          <div class="font-mono font-bold text-xs text-blue-400">30%</div>
          <div class="text-[10px] text-app-subtle">Maintenance</div>
        </div>
        <div class="px-3 py-2 rounded-lg bg-app-bg border border-app-border text-center">
          <div class="font-mono font-bold text-xs text-purple-400">20%</div>
          <div class="text-[10px] text-app-subtle">Community</div>
        </div>
        <div class="px-3 py-2 rounded-lg bg-app-bg border border-app-border text-center">
          <div class="font-mono font-bold text-xs text-amber-400">15%</div>
          <div class="text-[10px] text-app-subtle">Releases</div>
        </div>

        <a
          href="/how-we-score"
          class="px-4 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold transition-colors font-mono"
        >
          View Methodology &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Categories Grid Directory -->
  <section id="categories" class="my-14 scroll-mt-24">
    <div class="flex items-center justify-between gap-4 mb-6">
      <div>
        <span class="text-micro text-app-subtle block mb-1">MONITORED TAXONOMIES</span>
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-app-text">
          Browse by Category
        </h2>
      </div>
      <span class="text-xs font-mono text-app-subtle">
        13 Sectors Active
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {categoriesWithStats.map((cat) => (
        <CategoryCard
          category={cat}
          toolCount={cat.toolCount}
          avgScore={cat.avgScore}
        />
      ))}
    </div>
  </section>
</Layout>
