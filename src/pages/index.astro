---
import Layout from '../layouts/Layout.astro';
import LiveScanConsole from '../components/LiveScanConsole.astro';
import DetectionRadarHero from '../components/DetectionRadarHero.astro';
import FlagWall from '../components/FlagWall.astro';
import CategoryRadar from '../components/CategoryRadar.astro';
import BentoRow from '../components/BentoRow.astro';
import CategoryCard from '../components/CategoryCard.astro';
import AdSlot from '../components/AdSlot.astro';
import TrustBand from '../components/TrustBand.astro';
import TopRepos from '../components/TopRepos.astro';
import TrendingRepos from '../components/TrendingRepos.astro';
import StackBundles from '../components/StackBundles.astro';
import MatchQuiz from '../components/MatchQuiz.astro';
import { categories } from '../data/categories';
import { getAllTools, getSafestTools, getToolsByCategory } from '../utils/tools';

const allTools = getAllTools();
const safestTools = getSafestTools(3);

// Category stats
const categoriesWithStats = categories.map((cat) => {
  const tools = getToolsByCategory(cat.slug);
  const avgScore = tools.length > 0
    ? tools.reduce((acc, t) => acc + t.safety_score, 0) / tools.length
    : 0;
  return {
    ...cat,
    toolCount: tools.length,
    avgScore
  };
});
---

<Layout
  title="SafeOpenSource — Live Open-Source Security Operations Console"
  description="Continuous security scans for open-source tools with objective 0–100 Safety Scores. We watch repositories so you don't get burned."
>
  <!-- Mobile Sticky Category Pill Navigation (< md) -->
  <nav
    class="flex md:hidden overflow-x-auto no-scrollbar gap-2 py-2 px-4 -mx-4 -mt-6 mb-6 sticky top-14 sm:top-16 z-30 bg-[#0A0B0E]/90 backdrop-blur-md border-b border-[#23262E] items-center"
    aria-label="Quick Category Filter Navigation"
  >
    <a
      href="#categories"
      class="shrink-0 whitespace-nowrap px-3 py-1.5 rounded-full text-xs font-mono font-semibold bg-blue-600 text-white shadow-xs"
    >
      All Sectors
    </a>
    {categories.map((cat) => (
      <a
        href={`/categories/${cat.slug}`}
        class="shrink-0 whitespace-nowrap px-3 py-1.5 rounded-full text-xs font-mono font-medium text-app-muted hover:text-app-text bg-[#131519] border border-[#23262E] hover:border-app-border-hover transition-colors"
      >
        {cat.name}
      </a>
    ))}
  </nav>

  <!-- Hero Section: Security Ops Center Console -->
  <section class="py-8 sm:py-12 lg:py-16 text-center">
    <!-- Headline and Core Mission Statement -->
    <div class="max-w-4xl mx-auto mb-8 sm:mb-12">
      <div class="inline-flex items-center gap-2 text-micro text-emerald-400 font-mono mb-4 px-3.5 py-1.5 rounded-full border border-emerald-500/30 bg-emerald-950/20 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="tracking-wider">SECURITY OPS CENTER :: CONTINUOUS REPO TELEMETRY</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-app-text leading-[1.1] mb-5 sm:mb-6 max-w-4xl mx-auto">
        We watch these projects so you don't get <span class="text-rose-400">burned</span>.
      </h1>

      <p class="text-sm sm:text-base lg:text-lg text-gray-400 max-w-2xl mx-auto leading-relaxed font-sans">
        Not a software directory. A live mission-control station monitoring open-source software with verifiable 0–100 Safety Scores, OpenSSF Scorecards, and incident alerts.
      </p>
    </div>

    <!-- Pre-Audited Starter Kit Bundles (Promoted Above the Fold for Intent-Based Discovery) -->
    <div id="starter-kits" class="my-8 sm:my-12 lg:my-14 scroll-mt-24 text-left" aria-label="Curated Starter Kits">
      <StackBundles />
    </div>

    <!-- Observatory Radar Scope & Live Telemetry Verification Monitor (SOC Mission Control Console) -->
    <div class="my-10 sm:my-14 lg:my-16 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start text-left" id="soc-console" aria-label="Security Operations Center Console">
      <!-- Left (7 Cols on desktop): Continuous Defense Radar Scope -->
      <div class="w-full lg:col-span-7 min-w-0">
        <DetectionRadarHero />
      </div>

      <!-- Right (5 Cols on desktop): On-Demand Deep Scan & Continuous Telemetry Monitor -->
      <div class="w-full lg:col-span-5 min-w-0 space-y-6 scroll-mt-24" id="deep-scanner" aria-label="On-Demand Repository Audit">
        <!-- On-Demand Repository Audit Scanner Card -->
        <div class="rounded-xl border border-app-border bg-app-surface p-5 sm:p-6 shadow-xl">
          <div class="mb-4">
            <div class="flex items-center gap-2 mb-1.5">
              <span class="w-2 h-2 rounded-full bg-blue-500"></span>
              <span class="text-micro text-blue-400 font-mono tracking-wider">ON-DEMAND REPOSITORY AUDIT</span>
            </div>
            <h2 class="text-lg sm:text-xl font-bold text-app-text mb-1 tracking-tight">
              Deep Scan & Telemetry Stream
            </h2>
            <p class="text-xs sm:text-sm text-app-muted font-sans leading-relaxed">
              Don't see your tool monitored above? Paste any public GitHub repository for a real-time safety audit.
            </p>
          </div>

          <!-- Real-Time On-Demand Scanner Input Box -->
          <form action="/scan" method="GET" class="w-full" role="search">
            <div class="flex flex-col sm:flex-row items-stretch gap-2 p-1.5 rounded-xl border border-app-border bg-app-surface-2 shadow-inner">
              <div class="relative flex-1 min-w-0">
                <label for="repo-url-input" class="sr-only">Public Repository URL</label>
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-app-subtle">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  </svg>
                </div>
                <input
                  id="repo-url-input"
                  type="text"
                  name="url"
                  required
                  placeholder="Paste GitHub URL (e.g. owner/repo)"
                  class="w-full pl-10 pr-3 py-2.5 rounded-lg bg-transparent text-app-text placeholder:text-app-subtle text-xs font-mono focus:outline-none focus:ring-1 focus:ring-blue-500 border border-transparent min-h-[44px]"
                  autocomplete="off"
                  spellcheck="false"
                />
              </div>
              <button
                type="submit"
                class="px-5 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-500 active:bg-blue-700 text-white font-mono text-xs font-bold transition-colors shrink-0 flex items-center justify-center gap-1.5 cursor-pointer shadow-xs min-h-[44px]"
              >
                <span>Scan Repo</span>
                <span aria-hidden="true">&rarr;</span>
              </button>
            </div>

            <div class="flex flex-wrap items-center gap-1.5 mt-3 font-mono text-[11px] text-app-subtle">
              <span>Popular:</span>
              <a href="/scan?url=jellyfin/jellyfin" class="text-app-muted hover:text-app-accent underline">jellyfin</a>
              <span>&middot;</span>
              <a href="/scan?url=dani-garcia/vaultwarden" class="text-app-muted hover:text-app-accent underline">vaultwarden</a>
              <span>&middot;</span>
              <a href="/scan?url=louislam/uptime-kuma" class="text-app-muted hover:text-app-accent underline">uptime-kuma</a>
            </div>
          </form>
        </div>

        <!-- Live Telemetry Monitor (Real Data Strip) -->
        <LiveScanConsole />
      </div>
    </div>
  </section>

  <!-- Global High-Credibility Trust Band -->
  <TrustBand class="my-6" />

  <!-- 1. Top Ranked Repositories Leaderboard -->
  <TopRepos tools={allTools} activeSort="score" />

  <!-- 2. Momentum & Velocity Telemetry -->
  <TrendingRepos activeFilter="velocity" />

  <!-- Reserved Zero-CLS AdSlot Container -->
  <section class="my-6">
    <AdSlot format="leaderboard" />
  </section>

  <!-- 3. The Flag Wall (Incident Feed Section) -->
  <FlagWall />

  <!-- 4. Category Radar (13 Sectors SVG Grid) -->
  <CategoryRadar />

  <!-- 5. Monitored Taxonomies: Category Grid (moved below the fold) -->
  <section id="categories" class="my-14 scroll-mt-24" aria-label="Monitored Categories">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-6 pb-4 border-b border-app-border">
      <div>
        <span class="text-micro text-app-subtle block mb-1 font-mono tracking-wider uppercase">
          MONITORED TAXONOMIES &middot; CHOOSE A SECTOR TO INSPECT SAFETY SCORES
        </span>
        <h2 class="text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight text-app-text">
          Browse by Category
        </h2>
      </div>
      <span class="text-xs font-mono text-app-subtle shrink-0">
        13 Sectors Active
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4 gap-3 sm:gap-4 lg:gap-5 2xl:gap-6">
      {categoriesWithStats.map((cat) => (
        <CategoryCard
          category={cat}
          toolCount={cat.toolCount}
          avgScore={cat.avgScore}
          class="hover:border-emerald-500/50"
        />
      ))}
    </div>
  </section>

  <!-- 6. 3-Question Architecture Matcher Quiz -->
  <MatchQuiz />

  <!-- 7. Safest This Month Bento Grid -->
  <section class="my-14">
    <div class="flex items-center justify-between gap-4 mb-6">
      <div>
        <span class="text-micro text-emerald-400 block mb-1">VERIFIED HEALTHY</span>
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-app-text">
          Safest Tools This Month
        </h2>
      </div>
      <a href="/categories/monitoring-status" class="text-xs font-mono text-app-subtle hover:text-blue-400 transition-colors hidden sm:inline-block">
        Explore Healthy Stacks &rarr;
      </a>
    </div>

    <BentoRow tools={safestTools} />
  </section>

  <!-- How Scoring Works Strip -->
  <section class="my-14 rounded-2xl border border-app-border bg-app-surface p-6 sm:p-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="max-w-xl">
        <span class="text-micro text-blue-400 block mb-1">OBJECTIVE TELEMETRY</span>
        <h2 class="text-lg sm:text-xl font-bold text-app-text mb-2">
          Deterministic 0–100 Scoring Weights
        </h2>
        <p class="text-xs text-app-muted leading-relaxed">
          Scores are derived mathematically from four weighted dimensions: Security Health (35%), Maintenance Cadence (30%), Community Velocity (20%), and Release Hygiene (15%). No vendor can pay for higher scores.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <div class="px-3 py-2 rounded-lg bg-app-bg border border-app-border text-center">
          <div class="font-mono font-bold text-xs text-emerald-400">35%</div>
          <div class="text-[10px] text-app-subtle">Security</div>
        </div>
        <div class="px-3 py-2 rounded-lg bg-app-bg border border-app-border text-center">
          <div class="font-mono font-bold text-xs text-blue-400">30%</div>
          <div class="text-[10px] text-app-subtle">Maintenance</div>
        </div>
        <div class="px-3 py-2 rounded-lg bg-app-bg border border-app-border text-center">
          <div class="font-mono font-bold text-xs text-purple-400">20%</div>
          <div class="text-[10px] text-app-subtle">Community</div>
        </div>
        <div class="px-3 py-2 rounded-lg bg-app-bg border border-app-border text-center">
          <div class="font-mono font-bold text-xs text-amber-400">15%</div>
          <div class="text-[10px] text-app-subtle">Releases</div>
        </div>

        <a
          href="/how-we-score"
          class="px-4 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold transition-colors font-mono"
        >
          View Methodology &rarr;
        </a>
      </div>
    </div>
  </section>
</Layout>

