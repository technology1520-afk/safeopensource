---
import '../../styles/global.css';
import {
  verifyOwnerPassword,
  verifyTotp,
  createSession,
  recordAuthFailure,
  isRateLimited,
  getClientIp,
  resetAuthFailures,
} from '../../lib/admin/auth';
import { logAudit } from '../../lib/admin/audit';

export const prerender = false;

let error = '';
const ip = getClientIp(Astro.request);
const totpConfigured = Boolean(process.env.ADMIN_TOTP_SECRET);

if (Astro.request.method === 'POST') {
  if (isRateLimited(ip)) {
    error = 'Too many failed login attempts. Account locked for 60 seconds.';
  } else {
    try {
      const data = await Astro.request.formData();
      const email = (data.get('email') as string || '').trim().toLowerCase();
      const password = data.get('password') as string || '';
      const totpCode = (data.get('totp') as string || '').trim();

      const expectedEmail = (process.env.ADMIN_EMAIL || 'admin@safeopensource.org').trim().toLowerCase();

      const passwordValid = email === expectedEmail && (await verifyOwnerPassword(password));
      const totpValid = !totpConfigured || verifyTotp(totpCode);

      if (passwordValid && totpValid) {
        resetAuthFailures(ip);
        const session = createSession(email);

        Astro.cookies.set('sos_session', session.id, {
          path: '/admin',
          httpOnly: true,
          sameSite: 'strict',
          secure: process.env.NODE_ENV === 'production',
          maxAge: 30 * 60, // 30 minutes
        });

        logAudit('owner', 'LOGIN_SUCCESS', ip, { email });
        return Astro.redirect('/admin');
      } else {
        recordAuthFailure(ip);
        logAudit('anonymous', 'LOGIN_FAILURE', ip, {
          emailAttempted: email,
          reason: !passwordValid ? 'Invalid credentials' : 'Invalid TOTP token',
        });
        error = !passwordValid ? 'Authentication failed. Invalid credentials.' : 'Invalid 2FA TOTP code.';
      }
    } catch {
      error = 'Internal authentication error.';
    }
  }
}
---

<!doctype html>
<html lang="en" data-theme="lavender-lab" class="h-full bg-[var(--bg)] text-[var(--text)]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <!-- 404-shaped title to avoid leaking presence of admin portal to automated bots -->
    <title>404 Not Found</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

  </head>
  <body class="h-full flex items-center justify-center p-4 font-sans bg-[var(--bg)] text-[var(--text)] antialiased">
    <div class="w-full max-w-md">
      <!-- Instrument Header -->
      <div class="border border-[var(--border)] bg-[var(--surface)] rounded-t-lg px-4 py-3 flex items-center justify-between shadow-[var(--shadow)]">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-[var(--healthy)] animate-pulse"></span>
          <span class="font-mono text-xs text-[var(--text)] font-semibold tracking-wider uppercase">SOC // CONTROL PLANE</span>
        </div>
        <span class="font-mono text-[10px] text-[var(--text-3)]">RESTRICTED_ACCESS</span>
      </div>

      <!-- Main Login Container -->
      <div class="border-x border-b border-[var(--border)] bg-[var(--surface)] p-6 rounded-b-lg shadow-[var(--shadow)]">
        <div class="mb-6 text-center">
          <h1 class="text-xl font-bold tracking-tight text-[var(--text)] mb-1">Human Operator Gateway</h1>
          <p class="text-xs text-[var(--text-2)] font-mono">Argon2id Session Token · Dual-Gate Protected</p>
        </div>

        {error && (
          <div class="mb-5 p-3 rounded bg-[var(--risky-soft)] border border-[var(--risky)]/40 text-[var(--risky)] text-xs font-mono flex items-center gap-2">
            <svg class="w-4 h-4 shrink-0 text-[var(--risky)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span>{error}</span>
          </div>
        )}

        <form method="POST" class="space-y-4">
          <div>
            <label for="email" class="block text-xs font-mono text-[var(--text-2)] mb-1.5 uppercase tracking-wider">
              Operator Identifier
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="username"
              placeholder="owner@safeopensource.org"
              class="w-full px-3.5 py-2.5 rounded bg-[var(--surface-2)] border border-[var(--border)] text-[var(--text)] text-sm font-mono placeholder:text-[var(--text-3)] focus:outline-none focus:border-[var(--accent)] transition-colors"
            />
          </div>

          <div>
            <label for="password" class="block text-xs font-mono text-[var(--text-2)] mb-1.5 uppercase tracking-wider">
              Operator Secret
            </label>
            <input
              id="password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
              placeholder="••••••••••••••••"
              class="w-full px-3.5 py-2.5 rounded bg-[var(--surface-2)] border border-[var(--border)] text-[var(--text)] text-sm font-mono placeholder:text-[var(--text-3)] focus:outline-none focus:border-[var(--accent)] transition-colors"
            />
          </div>

          {totpConfigured && (
            <div>
              <label for="totp" class="block text-xs font-mono text-[var(--text-2)] mb-1.5 uppercase tracking-wider">
                Authenticator TOTP (6 Digits)
              </label>
              <input
                id="totp"
                name="totp"
                type="text"
                pattern="[0-9]{6}"
                inputmode="numeric"
                autocomplete="one-time-code"
                placeholder="000000"
                class="w-full px-3.5 py-2.5 rounded bg-[var(--surface-2)] border border-[var(--border)] text-[var(--text)] text-sm font-mono tracking-widest placeholder:text-[var(--text-3)] focus:outline-none focus:border-[var(--accent)] transition-colors"
              />
            </div>
          )}

          <button
            type="submit"
            class="w-full mt-2 px-4 py-2.5 rounded bg-[var(--accent)] hover:opacity-90 text-white font-mono text-xs font-semibold tracking-wider uppercase transition-opacity flex items-center justify-center gap-2 cursor-pointer shadow-sm"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            Authenticate Session
          </button>
        </form>

        <div class="mt-6 pt-4 border-t border-[var(--border)] text-center">
          <p class="font-mono text-[10px] text-[var(--text-3)] leading-relaxed">
            All attempts recorded in append-only audit trail. IP rate limiting strictly enforced at 5 failures/min.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
