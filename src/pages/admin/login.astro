---
import { verifyOwnerPassword, createSession, recordAuthFailure, isRateLimited, getClientIp, resetAuthFailures } from '../../lib/admin/auth';
import { logAudit } from '../../lib/admin/audit';

export const prerender = false;

let error = '';
const ip = getClientIp(Astro.request);

if (Astro.request.method === 'POST') {
  if (isRateLimited(ip)) {
    error = 'Too many failed login attempts. Account locked for 60 seconds.';
  } else {
    try {
      const data = await Astro.request.formData();
      const email = (data.get('email') as string || '').trim().toLowerCase();
      const password = data.get('password') as string || '';

      const expectedEmail = (process.env.ADMIN_EMAIL || 'admin@safeopensource.org').trim().toLowerCase();

      if (email === expectedEmail && await verifyOwnerPassword(password)) {
        resetAuthFailures(ip);
        const session = createSession(email);

        Astro.cookies.set('sos_session', session.id, {
          path: '/admin',
          httpOnly: true,
          sameSite: 'strict',
          secure: process.env.NODE_ENV === 'production',
          maxAge: 30 * 60, // 30 minutes
        });

        logAudit('owner', 'LOGIN_SUCCESS', ip, { email });
        return Astro.redirect('/admin');
      } else {
        recordAuthFailure(ip);
        logAudit('anonymous', 'LOGIN_FAILURE', ip, { emailAttempted: email });
        error = 'Authentication failed. Invalid credentials.';
      }
    } catch (err) {
      error = 'Internal authentication error.';
    }
  }
}
---

<!doctype html>
<html lang="en" class="dark h-full bg-[#0A0B0E] text-[#E6E8EB]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>SafeOpenSource Control Plane — Authenticate</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body class="h-full flex items-center justify-center p-4 font-sans bg-[#0A0B0E] text-[#E6E8EB] antialiased">
    <div class="w-full max-w-md">
      <!-- Terminal Header -->
      <div class="border border-[#23262E] bg-[#131519] rounded-t-lg px-4 py-3 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="font-mono text-xs text-zinc-400 font-semibold tracking-wider uppercase">SOC // CONTROL PLANE</span>
        </div>
        <span class="font-mono text-[10px] text-zinc-600">RESTRICTED_ACCESS</span>
      </div>

      <!-- Main Login Container -->
      <div class="border-x border-b border-[#23262E] bg-[#0E1015] p-6 rounded-b-lg shadow-2xl">
        <div class="mb-6 text-center">
          <h1 class="text-xl font-bold tracking-tight text-white mb-1">Human Operator Gateway</h1>
          <p class="text-xs text-zinc-400 font-mono">Argon2id Session Token · Dual-Gate Protected</p>
        </div>

        {error && (
          <div class="mb-5 p-3 rounded bg-red-950/40 border border-red-800/60 text-red-300 text-xs font-mono flex items-center gap-2">
            <svg class="w-4 h-4 shrink-0 text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span>{error}</span>
          </div>
        )}

        <form method="POST" class="space-y-4">
          <div>
            <label for="email" class="block text-xs font-mono text-zinc-400 mb-1.5 uppercase tracking-wider">
              Operator Identifier
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="username"
              placeholder="owner@safeopensource.org"
              class="w-full px-3.5 py-2.5 rounded bg-[#131519] border border-[#23262E] text-zinc-200 text-sm font-mono placeholder:text-zinc-600 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors"
            />
          </div>

          <div>
            <label for="password" class="block text-xs font-mono text-zinc-400 mb-1.5 uppercase tracking-wider">
              Operator Secret
            </label>
            <input
              id="password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
              placeholder="••••••••••••••••"
              class="w-full px-3.5 py-2.5 rounded bg-[#131519] border border-[#23262E] text-zinc-200 text-sm font-mono placeholder:text-zinc-600 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors"
            />
          </div>

          <button
            type="submit"
            class="w-full mt-2 px-4 py-2.5 rounded bg-blue-600 hover:bg-blue-500 text-white font-mono text-xs font-semibold tracking-wider uppercase transition-colors flex items-center justify-center gap-2 cursor-pointer"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            Authenticate Session
          </button>
        </form>

        <div class="mt-6 pt-4 border-t border-[#23262E]/60 text-center">
          <p class="font-mono text-[10px] text-zinc-600 leading-relaxed">
            All attempts recorded in append-only audit trail. IP rate limiting strictly enforced at 5 failures/min.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
