---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { listToolsSummary, getPendingQueueTools, runAccuracySelfTest } from '../../lib/admin/tools-service';
import { listRecentJobs } from '../../lib/admin/jobs';
import { getRecentAuditEntries } from '../../lib/admin/audit';
import os from 'node:os';

export const prerender = false;

const auth = Astro.locals.auth;
if (!auth || auth.principal !== 'owner') {
  return new Response('', { status: 404 });
}

const session = auth.session;
const csrfToken = session?.csrfToken || '';

// Telemetry & Records
const allTools = listToolsSummary();
const queueTools = getPendingQueueTools();
const listedTools = allTools.filter((t) => t.status === 'listed');
const unlistedTools = allTools.filter((t) => t.status === 'unlisted');
const flaggedTools = allTools.filter((t) => t.verdict === 'caution' || t.verdict === 'risky');
const recentJobs = listRecentJobs(6);
const recentAudit = getRecentAuditEntries(10);
const selfTest = runAccuracySelfTest();

const freeMemMb = Math.round(os.freemem() / (1024 * 1024));
const totalMemMb = Math.round(os.totalmem() / (1024 * 1024));
---

<AdminLayout title="Overview" activeTab="overview" csrfToken={csrfToken} userEmail={session?.email}>
  <!-- Accuracy Provenance & Regression Test Card -->
  <div class={`p-5 rounded-lg border shadow-[var(--shadow)] ${selfTest.passed ? 'bg-[var(--surface)] border-[var(--border)]' : 'bg-[var(--risky-soft)] border-[var(--risky)]'}`}>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
      <div class="flex items-center gap-2">
        <span class={`w-2.5 h-2.5 rounded-full ${selfTest.passed ? 'bg-[var(--healthy)]' : 'bg-[var(--risky)] animate-ping'}`}></span>
        <h2 class="font-mono text-sm font-bold tracking-wide uppercase text-[var(--text)]">
          Continuous Calibration Gate (Self-Test)
        </h2>
      </div>
      <span class={`px-2 py-0.5 rounded text-xs font-mono font-semibold ${selfTest.passed ? 'bg-[var(--healthy-soft)] text-[var(--healthy)]' : 'bg-[var(--risky)] text-white'}`}>
        {selfTest.passed ? '3 / 3 CHECKS PASSING' : 'CALIBRATION REGRESSION'}
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      {selfTest.checks.map((c) => (
        <div class="p-3 rounded bg-[var(--surface-2)] border border-[var(--border)]">
          <div class="flex items-center justify-between text-xs font-mono mb-1">
            <span class="font-semibold text-[var(--text)]">{c.name}</span>
            <span class={c.passed ? 'text-[var(--healthy)] font-bold' : 'text-[var(--risky)] font-bold'}>
              {c.passed ? '✓ OK' : '✕ FAIL'}
            </span>
          </div>
          <div class="font-mono text-[11px] text-[var(--text-3)] truncate">{c.repo}</div>
          <div class="font-mono text-[11px] text-[var(--text-2)] mt-1">
            Expected: <span class="text-[var(--text)]">{c.expected}</span>
          </div>
          <div class="font-mono text-[11px] text-[var(--text-2)]">
            Actual: <span class={c.passed ? 'text-[var(--healthy)]' : 'text-[var(--risky)] font-semibold'}>{c.actual}</span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Metric Instruments: Health & Inventory -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- Pipeline Health -->
    <div class="p-4 rounded-lg bg-[var(--surface)] border border-[var(--border)] shadow-[var(--shadow)]">
      <div class="flex items-center justify-between mb-2">
        <span class="font-mono text-xs text-[var(--text-3)] uppercase tracking-wider">PIPELINE SWEEP</span>
        <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-[var(--healthy-soft)] text-[var(--healthy)]">
          NOMINAL
        </span>
      </div>
      <div class="font-mono text-2xl font-bold text-[var(--text)] mb-1">00:14:22 AGO</div>
      <p class="font-mono text-xs text-[var(--text-2)]">Cron: 0 */6 * * * · Next: 22:00 UTC</p>
    </div>

    <!-- GitHub Quota & Budgets -->
    <div class="p-4 rounded-lg bg-[var(--surface)] border border-[var(--border)] shadow-[var(--shadow)]">
      <div class="flex items-center justify-between mb-2">
        <span class="font-mono text-xs text-[var(--text-3)] uppercase tracking-wider">GITHUB API QUOTA</span>
        <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-[var(--accent-soft)] text-[var(--accent)]">
          4,850 / 5,000
        </span>
      </div>
      <div class="font-mono text-2xl font-bold text-[var(--text)] mb-1">97.0% LEFT</div>
      <p class="font-mono text-xs text-[var(--text-2)]">Resets in 45m · Rate limit safe</p>
    </div>

    <!-- OpenRouter & Disk -->
    <div class="p-4 rounded-lg bg-[var(--surface)] border border-[var(--border)] shadow-[var(--shadow)]">
      <div class="flex items-center justify-between mb-2">
        <span class="font-mono text-xs text-[var(--text-3)] uppercase tracking-wider">AI CREDIT & DISK</span>
        <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-[var(--surface-2)] text-[var(--text)] border border-[var(--border)]">
          TIER 3
        </span>
      </div>
      <div class="font-mono text-2xl font-bold text-[var(--text)] mb-1">$14.20 BAL</div>
      <p class="font-mono text-xs text-[var(--text-2)]">Disk: {freeMemMb}MB free of {totalMemMb}MB</p>
    </div>

    <!-- Inventory Counts -->
    <div class="p-4 rounded-lg bg-[var(--surface)] border border-[var(--border)] shadow-[var(--shadow)]">
      <div class="flex items-center justify-between mb-2">
        <span class="font-mono text-xs text-[var(--text-3)] uppercase tracking-wider">INVENTORY</span>
        <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-[var(--accent-soft)] text-[var(--accent)]">
          {allTools.length} REPOS
        </span>
      </div>
      <div class="font-mono text-2xl font-bold text-[var(--text)] mb-1">
        {listedTools.length} <span class="text-xs font-normal text-[var(--text-2)]">LISTED</span> · {unlistedTools.length} <span class="text-xs font-normal text-[var(--caution)]">UNLISTED</span>
      </div>
      <p class="font-mono text-xs text-[var(--text-2)]">{flaggedTools.length} flagged with Caution or Risky</p>
    </div>
  </div>

  <!-- Operational Action Row -->
  <div class="flex flex-wrap items-center justify-between gap-4 p-4 rounded-lg bg-[var(--surface)] border border-[var(--border)] shadow-[var(--shadow)]">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded bg-[var(--accent-soft)] text-[var(--accent)] flex items-center justify-center font-bold font-mono text-sm">
        !
      </div>
      <div>
        <div class="text-xs font-mono font-semibold text-[var(--text)]">ACCURACY GATE & STATIC DEPLOYMENT</div>
        <div class="text-xs text-[var(--text-2)]">
          {queueTools.length} unlisted tools in approval queue. Public catalog updates strictly require owner approval.
        </div>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <a
        href="/admin/queue"
        class="px-3 py-1.5 rounded bg-[var(--accent)] hover:opacity-90 text-white font-mono text-xs font-semibold transition-opacity flex items-center gap-1.5"
      >
        <span>Review Queue</span>
        {queueTools.length > 0 && (
          <span class="px-1.5 py-0.2 rounded-full bg-white/20 text-white text-[10px]">
            {queueTools.length}
          </span>
        )}
      </a>

      <form action="/admin/api/rebuild" method="POST" class="inline">
        <input type="hidden" name="csrf" value={csrfToken} />
        <button
          type="submit"
          class="px-3 py-1.5 rounded bg-[var(--surface-2)] hover:bg-[var(--accent-soft)] text-[var(--text)] hover:text-[var(--accent)] border border-[var(--border)] font-mono text-xs font-semibold transition-colors cursor-pointer"
        >
          Rebuild (deploy.sh)
        </button>
      </form>
    </div>
  </div>

  <!-- Two Columns: Recent Audit Tail & Active Pipeline Jobs -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Audit Trail Tail -->
    <div class="p-4 rounded-lg bg-[var(--surface)] border border-[var(--border)] shadow-[var(--shadow)]">
      <div class="flex items-center justify-between mb-3 border-b border-[var(--border)] pb-2">
        <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--text)]">
          Recent Audit Trail (Immutable)
        </h3>
        <a href="/admin/audit" class="text-xs font-mono text-[var(--accent)] hover:underline">
          View All →
        </a>
      </div>

      <div class="space-y-2">
        {recentAudit.length === 0 ? (
          <div class="text-xs font-mono text-[var(--text-3)] py-4 text-center">No recent audit log entries</div>
        ) : (
          recentAudit.slice(0, 6).map((entry) => (
            <div class="p-2.5 rounded bg-[var(--surface-2)] border border-[var(--border)] flex items-start justify-between gap-3 text-xs font-mono">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span
                    class={`px-1.5 py-0.5 rounded text-[10px] font-bold ${
                      entry.who === 'owner'
                        ? 'bg-[var(--accent-soft)] text-[var(--accent)]'
                        : entry.who === 'agent'
                        ? 'bg-blue-100 text-blue-800'
                        : 'bg-[var(--caution-soft)] text-[var(--caution)]'
                    }`}
                  >
                    {entry.who.toUpperCase()}
                  </span>
                  <span class="font-semibold text-[var(--text)]">{entry.action}</span>
                </div>
                <div class="text-[11px] text-[var(--text-2)] truncate max-w-sm">
                  {entry.target || JSON.stringify(entry.details || {})}
                </div>
              </div>
              <div class="text-[10px] text-[var(--text-3)] text-right whitespace-nowrap">
                {new Date(entry.at).toLocaleTimeString()}
              </div>
            </div>
          ))
        )}
      </div>
    </div>

    <!-- Active Pipeline Jobs -->
    <div class="p-4 rounded-lg bg-[var(--surface)] border border-[var(--border)] shadow-[var(--shadow)]">
      <div class="flex items-center justify-between mb-3 border-b border-[var(--border)] pb-2">
        <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--text)]">
          Telemetry & Scanner Jobs
        </h3>
        <a href="/admin/scans" class="text-xs font-mono text-[var(--accent)] hover:underline">
          Job History →
        </a>
      </div>

      <div class="space-y-2">
        {recentJobs.length === 0 ? (
          <div class="text-xs font-mono text-[var(--text-3)] py-4 text-center">No active pipeline jobs</div>
        ) : (
          recentJobs.slice(0, 6).map((job) => (
            <div class="p-2.5 rounded bg-[var(--surface-2)] border border-[var(--border)] flex items-start justify-between gap-3 text-xs font-mono">
              <div>
                <div class="flex items-center gap-2">
                  <span
                    class={`px-1.5 py-0.5 rounded text-[10px] font-bold ${
                      job.status === 'completed'
                        ? 'bg-[var(--healthy-soft)] text-[var(--healthy)]'
                        : job.status === 'running'
                        ? 'bg-[var(--accent-soft)] text-[var(--accent)] animate-pulse'
                        : 'bg-[var(--risky-soft)] text-[var(--risky)]'
                    }`}
                  >
                    {job.status.toUpperCase()}
                  </span>
                  <span class="font-semibold text-[var(--text)]">{job.type.toUpperCase()}</span>
                  <span class="text-[var(--text-3)]">({job.target})</span>
                </div>
                <div class="text-[11px] text-[var(--text-2)] mt-0.5">
                  Stages: GitHub API → Scorecard → Advisory DB → Derivation
                </div>
              </div>
              <div class="text-[10px] text-[var(--text-3)] text-right">
                {new Date(job.createdAt).toLocaleTimeString()}
              </div>
            </div>
          ))
        )}
      </div>
    </div>
  </div>
</AdminLayout>
