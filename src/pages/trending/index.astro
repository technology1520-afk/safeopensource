---
import Layout from '../../layouts/Layout.astro';
import TrendingRepos from '../../components/TrendingRepos.astro';
import TrustBand from '../../components/TrustBand.astro';
import AdSlot from '../../components/AdSlot.astro';
---

<Layout
  title="Trending Open-Source Telemetry & Velocity — SafeOpenSource"
  description="Real-time 7-day momentum and score drift across audited open-source repositories. No fabricated trends."
>
  <nav class="flex items-center gap-2 text-xs font-mono text-app-subtle mb-6" aria-label="Breadcrumb">
    <a href="/" class="hover:text-app-text">Home</a>
    <span>/</span>
    <span class="text-app-text font-medium">Trending Telemetry</span>
  </nav>

  <TrustBand class="mb-8" />

  <TrendingRepos activeFilter="velocity" />

  <section class="my-8">
    <AdSlot format="leaderboard" />
  </section>
</Layout>

