---
import type { ToolData } from '../types/tool';

interface Props {
  tool: ToolData;
  class?: string;
}

const { tool, class: className = '' } = Astro.props;

// Date formatter
function formatDate(dateStr?: string): string {
  if (!dateStr) return 'Recent Audit';
  try {
    return new Date(dateStr).toISOString().split('T')[0];
  } catch {
    return dateStr;
  }
}

const perm = tool.permission_model || {
  asks_before_destructive: false,
  approval_prompt_detail: 'Default configuration executes without interactive approval gates.',
  execution_environment: 'Raw Host Shell',
  filesystem_access: 'Unrestricted Host Filesystem',
  network_access: 'Unrestricted Internet Access',
  verdict: 'Caution: Unsandboxed execution model. Ensure manual confirmation flags are enabled.',
  review_status: 'approved',
};

const cves = tool.cves || [];
const incidents = tool.incident_history || [];
const scanDate = formatDate(tool.scanned_at);
---

<div class={`space-y-6 ${className}`}>
  <!-- 1. MANDATORY "RUNS WITH YOUR CREDENTIALS" WARNING CHIP -->
  <aside
    class="p-4 rounded-xl border border-amber-500/40 bg-gradient-to-r from-amber-950/30 to-amber-900/10 text-amber-200"
    role="alert"
  >
    <div class="flex items-start gap-3">
      <div class="w-8 h-8 rounded-lg bg-amber-500/20 border border-amber-500/30 flex items-center justify-center shrink-0 text-amber-400 mt-0.5">
        <svg class="w-4 h-4 animate-pulse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
          <line x1="12" y1="9" x2="12" y2="13"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
      </div>

      <div class="flex-1">
        <div class="flex items-center gap-2 mb-1 flex-wrap">
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[11px] font-mono font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40 tracking-wider uppercase">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
            RUNS WITH YOUR CREDENTIALS
          </span>
          <span class="font-mono text-xs text-amber-400/80">THREAT MODEL NOTICE</span>
        </div>

        <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed font-sans">
          This autonomous AI agent executes shell scripts, filesystem reads/writes, and browser actions with the
          <strong>active operator's host credentials</strong> by design. A malicious prompt injection or unvetted tool call
          can compromise local SSH keys, cloud tokens, and environmental secrets.
        </p>

        <div class="mt-3 pt-2.5 border-t border-amber-500/20 flex flex-wrap items-center justify-between gap-2 text-xs font-mono text-amber-400/90">
          <span>Enforce: Rootless container or dedicated disposable API keys</span>
          <a
            href="/how-to-run-an-ai-agent-safely"
            class="text-amber-300 hover:text-white underline font-semibold inline-flex items-center gap-1"
          >
            Read Safety Guide →
          </a>
        </div>
      </div>
    </div>
  </aside>

  <!-- 2. PERMISSION-MODEL SUMMARY -->
  <section class="rounded-2xl border border-app-border bg-app-surface p-6 sm:p-7">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5 pb-4 border-b border-app-border">
      <div>
        <span class="text-micro text-blue-400 font-mono block mb-1">AGENT CAPABILITY AUDIT</span>
        <h2 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
          <span>Permission & Sandboxing Architecture</span>
        </h2>
      </div>

      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-black/40 border border-app-border font-mono text-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span class="text-zinc-400">HUMAN AUDIT:</span>
        <span class="text-emerald-400 font-bold uppercase">{perm.review_status}</span>
      </div>
    </div>

    <!-- 4-Box Permission Metrics Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-5">
      <!-- 1. Destructive Action Approval -->
      <div class="p-4 rounded-xl border border-app-border bg-app-bg">
        <span class="text-[10px] font-mono text-app-subtle uppercase tracking-wider block mb-1.5">
          DESTRUCTIVE ACTION GATE
        </span>
        <div class="flex items-center gap-2 mb-1.5">
          {perm.asks_before_destructive ? (
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-mono font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              ASKS CONFIRMATION
            </span>
          ) : (
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-mono font-bold bg-rose-500/10 text-rose-400 border border-rose-500/20">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
              </svg>
              AUTONOMOUS (NO PROMPT)
            </span>
          )}
        </div>
        <p class="text-xs text-app-muted leading-relaxed font-sans">{perm.approval_prompt_detail}</p>
      </div>

      <!-- 2. Execution Environment -->
      <div class="p-4 rounded-xl border border-app-border bg-app-bg">
        <span class="text-[10px] font-mono text-app-subtle uppercase tracking-wider block mb-1.5">
          EXECUTION RUNTIME
        </span>
        <div class="font-mono text-sm font-bold text-white mb-1">
          {perm.execution_environment}
        </div>
        <p class="text-xs text-app-muted leading-relaxed font-sans">
          {perm.execution_environment.includes('Docker') || perm.execution_environment.includes('Sandbox')
            ? 'Guest container filesystem isolates host OS from tampering.'
            : 'Commands execute directly on host kernel; zero OS-level sandbox.'}
        </p>
      </div>

      <!-- 3. Filesystem Access -->
      <div class="p-4 rounded-xl border border-app-border bg-app-bg">
        <span class="text-[10px] font-mono text-app-subtle uppercase tracking-wider block mb-1.5">
          FILESYSTEM PERIMETER
        </span>
        <div class="font-mono text-sm font-bold text-white mb-1">
          {perm.filesystem_access}
        </div>
        <p class="text-xs text-app-muted leading-relaxed font-sans">
          {perm.filesystem_access.includes('Scoped')
            ? 'Access restricted to specified project directory volume.'
            : 'Unrestricted access to operator $HOME, dotfiles, and certificates.'}
        </p>
      </div>

      <!-- 4. Network Egress -->
      <div class="p-4 rounded-xl border border-app-border bg-app-bg">
        <span class="text-[10px] font-mono text-app-subtle uppercase tracking-wider block mb-1.5">
          NETWORK EGRESS
        </span>
        <div class="font-mono text-sm font-bold text-white mb-1">
          {perm.network_access}
        </div>
        <p class="text-xs text-app-muted leading-relaxed font-sans">
          {perm.network_access.includes('Proxy') || perm.network_access.includes('LLM')
            ? 'Outbound traffic scoped exclusively to authorized endpoints.'
            : 'Arbitrary outbound connections allowed (vulnerable to SSRF/data exfil).'}
        </p>
      </div>
    </div>

    <!-- Human Written Verdict Callout -->
    <div class="p-3.5 rounded-lg bg-black/40 border border-app-border flex items-start gap-3">
      <span class="text-blue-400 mt-0.5 shrink-0">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 16v-4"></path>
          <path d="M12 8h.01"></path>
        </svg>
      </span>
      <div class="text-xs leading-relaxed">
        <strong class="text-white font-mono uppercase tracking-wider">OPERATOR VERDICT:</strong>
        <span class="text-zinc-300 font-sans ml-1">{perm.verdict}</span>
      </div>
    </div>
  </section>

  <!-- 3. CVE ADVISORY PANEL & 4. INCIDENT HISTORY -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- CVE Advisory Panel -->
    <section class="rounded-2xl border border-app-border bg-app-surface p-6 flex flex-col">
      <div class="flex items-center justify-between pb-3.5 mb-4 border-b border-app-border">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <h3 class="font-mono text-sm font-bold text-white uppercase tracking-wider">
            GitHub Advisory Database CVEs
          </h3>
        </div>
        <span class="text-[10px] font-mono text-app-subtle">AUDITED: {scanDate}</span>
      </div>

      <div class="flex-1 flex flex-col justify-center">
        {cves.length === 0 && (
          <div class="p-6 rounded-xl border border-dashed border-app-border bg-app-bg/60 text-center font-mono">
            <div class="w-8 h-8 rounded-full bg-emerald-950/40 border border-emerald-500/30 flex items-center justify-center text-emerald-400 mx-auto mb-2">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <p class="text-xs text-emerald-400 font-bold mb-1">NO KNOWN CVEs DETECTED</p>
            <p class="text-xs text-app-muted font-sans">
              Zero public vulnerabilities recorded in GitHub Advisory Database as of {scanDate}.
            </p>
          </div>
        )}

        {cves.length > 0 && (
          <div class="space-y-3">
            {cves.map((cve) => (
              <div class="p-3.5 rounded-xl border border-app-border bg-app-bg space-y-2">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                  <div class="flex items-center gap-2">
                    <span class="font-mono text-xs font-bold text-white">{cve.id}</span>
                    <span
                      class:list={[
                        "px-1.5 py-0.5 rounded text-micro font-mono font-bold uppercase",
                        cve.severity === 'critical' && "bg-rose-500/20 text-rose-400 border border-rose-500/30",
                        cve.severity === 'high' && "bg-amber-500/20 text-amber-400 border border-amber-500/30",
                        cve.severity !== 'critical' && cve.severity !== 'high' && "bg-blue-500/20 text-blue-400 border border-blue-500/30"
                      ]}
                    >
                      {cve.severity}
                    </span>
                  </div>

                  <span
                    class:list={[
                      "font-mono text-micro px-2 py-0.5 rounded",
                      cve.fix_status === 'fixed'
                        ? "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20"
                        : "bg-rose-500/10 text-rose-400 border border-rose-500/20"
                    ]}
                  >
                    {cve.fix_status === 'fixed' ? `Patched in ${cve.fixed_in || 'latest'}` : 'Unpatched'}
                  </span>
                </div>

                <p class="text-xs text-zinc-300 font-sans leading-relaxed">{cve.summary}</p>

                {cve.url && (
                  <div class="pt-1.5 border-t border-app-border/40 text-[11px] font-mono">
                    <a
                      href={cve.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-blue-400 hover:text-blue-300 underline inline-flex items-center gap-1"
                    >
                      <span>View Advisory Details &nearr;</span>
                    </a>
                  </div>
                )}
              </div>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- Incident & Prompt-Injection History -->
    <section class="rounded-2xl border border-app-border bg-app-surface p-6 flex flex-col">
      <div class="flex items-center justify-between pb-3.5 mb-4 border-b border-app-border">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
            <line x1="12" y1="9" x2="12" y2="13"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
          <h3 class="font-mono text-sm font-bold text-white uppercase tracking-wider">
            Documented Escape &amp; Injection History
          </h3>
        </div>
        <span class="text-[10px] font-mono text-app-subtle">LOGGED EVENTS</span>
      </div>

      <div class="flex-1 flex flex-col justify-center">
        {incidents.length === 0 && (
          <div class="p-6 rounded-xl border border-dashed border-app-border bg-app-bg/60 text-center font-mono">
            <div class="w-8 h-8 rounded-full bg-blue-950/40 border border-blue-500/30 flex items-center justify-center text-blue-400 mx-auto mb-2">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            </div>
            <p class="text-xs text-blue-400 font-bold mb-1">NO ESCAPE INCIDENTS DOCUMENTED</p>
            <p class="text-xs text-app-muted font-sans">
              No verified prompt-injection or sandbox-escape regressions documented as of {scanDate}.
            </p>
          </div>
        )}

        {incidents.length > 0 && (
          <div class="space-y-3">
            {incidents.map((inc) => (
              <div class="p-3.5 rounded-xl border border-app-border bg-app-bg space-y-2">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                  <span class="font-mono text-xs font-bold text-white">{inc.title}</span>
                  <span class="font-mono text-[10px] text-zinc-500">{inc.date}</span>
                </div>

                <p class="text-xs text-zinc-300 font-sans leading-relaxed">{inc.description}</p>

                <div class="p-2 rounded bg-amber-950/20 border border-amber-500/20 text-[11px] font-mono text-amber-300">
                  <span class="font-bold">Mitigation:</span> {inc.mitigation}
                </div>

                {inc.link && (
                  <div class="pt-1 text-[11px] font-mono">
                    <a
                      href={inc.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-blue-400 hover:text-blue-300 underline inline-flex items-center gap-1"
                    >
                      <span>Read Incident Analysis &nearr;</span>
                    </a>
                  </div>
                )}
              </div>
            ))}
          </div>
        )}
      </div>
    </section>
  </div>
</div>
