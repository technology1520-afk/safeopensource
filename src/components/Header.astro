---
import { getAllTools } from '../utils/tools';
import SearchDialog from './SearchDialog';

const allTools = getAllTools();
---

<header class="sticky top-0 z-40 w-full border-b border-app-border bg-app-bg/95 backdrop-blur-md">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 h-16 grid grid-cols-[auto_1fr_auto] items-center gap-3 sm:gap-6">
    <!-- Zone 1: Brand Logo & Live SOC Status LED -->
    <div class="flex items-center gap-3 shrink-0">
      <a href="/" class="flex items-center gap-2.5 text-app-text hover:text-app-accent shrink-0 group">
        <div class="w-8 h-8 rounded-lg bg-blue-600/10 border border-blue-500/30 flex items-center justify-center text-blue-400 group-hover:border-blue-500/60 transition-colors shrink-0">
          <svg class="w-4 h-4 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-bold text-sm sm:text-base tracking-tight leading-none">
            SafeOpenSource<span class="text-blue-500">.org</span>
          </span>
          <span class="text-[10px] font-mono text-app-subtle leading-none mt-1">
            Open-source Safety Scores
          </span>
        </div>
      </a>

      <!-- Unclipped Live SOC Status LED -->
      <div class="hidden xl:flex items-center gap-2 pl-3 border-l border-app-border py-1">
        <span class="relative flex h-2 w-2 shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="text-micro text-emerald-400 font-mono font-bold tracking-wider">
          SOC ACTIVE
        </span>
      </div>
    </div>

    <!-- Zone 2: Flexible Center Search Island (Never overflows or crowds nav) -->
    <div class="hidden md:flex justify-center w-full min-w-0 px-1 sm:px-4">
      <div class="w-full max-w-sm lg:max-w-md">
        <SearchDialog client:idle tools={allTools} />
      </div>
    </div>

    <!-- Zone 3: Navigation Links & Theme Toggle (Fixed Right, Zero Overlap) -->
    <nav class="flex items-center justify-end gap-1 sm:gap-3 text-xs font-medium text-app-muted shrink-0 whitespace-nowrap">
      <div class="block md:hidden">
        <SearchDialog client:idle tools={allTools} />
      </div>

      <a href="/starter-kits" class="hover:text-app-text px-2.5 py-1.5 rounded-md hover:bg-app-surface transition-colors hidden sm:inline-block">
        Starter Kits
      </a>

      <a href="/how-we-score" class="hover:text-app-text px-2.5 py-1.5 rounded-md hover:bg-app-surface transition-colors hidden sm:inline-block">
        Methodology
      </a>

      <!-- Unmistakable "Scan Repo" Solid CTA Button + Dropdown Caret Menu -->
      <div class="relative inline-flex items-center" id="scan-repo-cta-group">
        <div class="inline-flex items-stretch rounded-lg shadow-xs">
          <a
            href="/scan"
            id="scan-repo-primary-btn"
            class="scan-repo-cta-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-l-lg font-mono font-semibold text-xs cursor-pointer select-none"
          >
            <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
            <span>Scan Repo</span>
          </a>
          <button
            type="button"
            id="scan-repo-caret-btn"
            aria-label="More scan actions"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="scan-repo-dropdown-menu"
            class="scan-repo-cta-caret inline-flex items-center justify-center px-2 py-1.5 rounded-r-lg border-l border-white/25 cursor-pointer select-none"
          >
            <svg class="w-3.5 h-3.5 transition-transform duration-150" id="scan-repo-caret-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>
        </div>

        <!-- Dropdown Menu ("Scan a repo…" / "Paste URL") -->
        <div
          id="scan-repo-dropdown-menu"
          role="menu"
          aria-label="Scan repository actions"
          class="hidden absolute right-0 top-full mt-2 w-48 rounded-xl border border-app-border bg-app-surface p-1.5 z-50 font-mono text-xs shadow-lg"
        >
          <a
            href="/scan"
            role="menuitem"
            class="flex items-center justify-between px-3 py-2 rounded-lg text-app-text hover:bg-app-surface-2 transition-colors"
          >
            <span>Scan a repo&hellip;</span>
            <span class="text-[10px] text-app-muted">&rarr;</span>
          </a>
          <button
            type="button"
            id="scan-repo-paste-action"
            role="menuitem"
            class="w-full flex items-center justify-between px-3 py-2 rounded-lg text-app-text hover:bg-app-surface-2 transition-colors text-left cursor-pointer"
          >
            <span>Paste URL</span>
            <span class="text-[10px] text-app-accent">⌘V</span>
          </button>
        </div>
      </div>

      <!-- Dual Personality Theme Toggle (Lavender Lab <-> Cosmic Void) -->
      <button
        type="button"
        id="theme-toggle"
        class="p-2 rounded-lg border border-app-border bg-app-surface hover:bg-app-surface-hover text-app-muted hover:text-app-text transition-colors cursor-pointer"
        aria-label="Switch between Lavender Lab and Cosmic Void themes"
        title="Switch Theme (Lavender Lab / Cosmic Void)"
      >
        <svg id="theme-moon" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <svg id="theme-sun" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5" />
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    const toggle = document.getElementById('theme-toggle');
    const sun = document.getElementById('theme-sun');
    const moon = document.getElementById('theme-moon');

    function resolveTheme() {
      const currentAttr = document.documentElement.getAttribute('data-theme');
      if (currentAttr === 'lavender-lab' || currentAttr === 'light') return 'lavender-lab';
      if (currentAttr === 'cosmic-void' || currentAttr === 'dark') return 'cosmic-void';
      const saved = localStorage.getItem('sos-primary-theme') || localStorage.getItem('sos-theme') || localStorage.getItem('theme');
      if (saved === 'lavender-lab' || saved === 'light') return 'lavender-lab';
      if (saved === 'cosmic-void' || saved === 'dark') return 'cosmic-void';
      return 'lavender-lab';
    }

    function applyTheme(theme) {
      const normalized = (theme === 'lavender-lab' || theme === 'light') ? 'lavender-lab' : 'cosmic-void';
      document.documentElement.setAttribute('data-theme', normalized);
      if (normalized === 'lavender-lab') {
        sun?.classList.add('hidden');
        moon?.classList.remove('hidden');
      } else {
        sun?.classList.remove('hidden');
        moon?.classList.add('hidden');
      }
    }

    applyTheme(resolveTheme());

    toggle?.addEventListener('click', () => {
      const current = resolveTheme();
      const next = current === 'lavender-lab' ? 'cosmic-void' : 'lavender-lab';
      localStorage.setItem('sos-lavender-v1', next);
      localStorage.setItem('sos-primary-theme', next);
      localStorage.setItem('sos-theme', next);
      localStorage.setItem('theme', next);
      applyTheme(next);
    });

    // Scan Repo Dropdown Caret Menu
    const caretBtn = document.getElementById('scan-repo-caret-btn');
    const caretIcon = document.getElementById('scan-repo-caret-icon');
    const dropdownMenu = document.getElementById('scan-repo-dropdown-menu');
    const pasteAction = document.getElementById('scan-repo-paste-action');
    const ctaGroup = document.getElementById('scan-repo-cta-group');

    function closeDropdown() {
      dropdownMenu?.classList.add('hidden');
      caretBtn?.setAttribute('aria-expanded', 'false');
      caretIcon?.classList.remove('rotate-180');
    }

    caretBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = dropdownMenu?.classList.contains('hidden');
      if (isHidden) {
        dropdownMenu?.classList.remove('hidden');
        caretBtn?.setAttribute('aria-expanded', 'true');
        caretIcon?.classList.add('rotate-180');
      } else {
        closeDropdown();
      }
    });

    document.addEventListener('click', (e) => {
      if (ctaGroup && !ctaGroup.contains(e.target)) {
        closeDropdown();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDropdown();
    });

    pasteAction?.addEventListener('click', async () => {
      closeDropdown();
      let pastedText = '';
      try {
        if (navigator.clipboard && navigator.clipboard.readText) {
          pastedText = (await navigator.clipboard.readText()).trim();
        }
      } catch {
        // Fallback if clipboard permission denied
      }
      const scanInput = document.getElementById('scan-url-input') || document.querySelector('input[name="url"]');
      if (scanInput && 'value' in scanInput) {
        if (pastedText) scanInput.value = pastedText;
        scanInput.focus();
      } else {
        const dest = pastedText ? `/scan?url=${encodeURIComponent(pastedText)}` : '/scan?paste=1';
        window.location.href = dest;
      }
    });
  })();
</script>

