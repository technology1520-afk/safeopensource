---
import type { ToolData } from '../types/tool';
import VerdictBadge from './VerdictBadge.astro';

interface Props {
  tools: ToolData[];
  activeSort?: 'score' | 'stars' | 'beginners';
  class?: string;
}

const { tools, activeSort = 'score', class: className = '' } = Astro.props;

// Sort based on active tab
let sortedTools = [...tools];
if (activeSort === 'stars') {
  sortedTools.sort((a, b) => b.stars - a.stars);
} else if (activeSort === 'beginners') {
  sortedTools = sortedTools
    .filter((t) => t.self_host_difficulty === 'Easy')
    .sort((a, b) => b.safety_score - a.safety_score);
} else {
  // default: overall safety score
  sortedTools.sort((a, b) => b.safety_score - a.safety_score);
}

const rankOne = sortedTools[0];
const ranksTwoToFive = sortedTools.slice(1, 5);

function getDecidingFactor(t: ToolData): string {
  if (t.components.security_health >= 95 && t.components.maintenance >= 95) {
    return `Security ${t.components.security_health} · Maintenance ${t.components.maintenance}`;
  }
  if (t.components.security_health >= 94) {
    return `Security Health ${t.components.security_health} · OpenSSF ${t.scorecard || 8.5}/10`;
  }
  return `Maintenance ${t.components.maintenance} · Community ${t.components.community}`;
}
---

<section class={`my-14 rounded-2xl border border-app-border bg-[#0a0c10] p-6 sm:p-8 scroll-mt-24 ${className}`} id="top-repos">
  <!-- Section Title & Real URL Tabs -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-app-border mb-6">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="w-2 h-2 rounded-full bg-blue-500"></span>
        <span class="text-micro text-blue-400">LEADERBOARD BENCHMARK</span>
      </div>
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-app-text">
        Top Ranked Repositories
      </h2>
      <p class="text-xs text-app-muted mt-1 leading-relaxed">
        Strict mathematical ranking. Each tool earned its position from verified OpenSSF heuristics and commit vitality.
      </p>
    </div>

    <!-- Sort Tabs as REAL URL Links (SEO Requirement) -->
    <nav class="flex items-center gap-1.5 p-1 rounded-xl bg-[#131519] border border-app-border font-mono text-xs" aria-label="Ranking tabs">
      <a
        href="/#top-repos"
        class={`px-3 py-1.5 rounded-lg transition-colors ${
          activeSort === 'score'
            ? 'bg-blue-600 text-white font-medium shadow-xs'
            : 'text-app-muted hover:text-white hover:bg-app-surface'
        }`}
      >
        Overall Score
      </a>
      <a
        href="/top/most-starred"
        class={`px-3 py-1.5 rounded-lg transition-colors ${
          activeSort === 'stars'
            ? 'bg-blue-600 text-white font-medium shadow-xs'
            : 'text-app-muted hover:text-white hover:bg-app-surface'
        }`}
      >
        Most Starred
      </a>
      <a
        href="/top/beginners"
        class={`px-3 py-1.5 rounded-lg transition-colors ${
          activeSort === 'beginners'
            ? 'bg-blue-600 text-white font-medium shadow-xs'
            : 'text-app-muted hover:text-white hover:bg-app-surface'
        }`}
      >
        Best for Beginners
      </a>
    </nav>
  </div>

  <!-- Bento Layout: Rank 1 is Bento-Large, 2-5 are Compact Rows -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- RANK 1: BENTO LARGE CARD (5 cols) -->
    {rankOne && (
      <div class="lg:col-span-5 rounded-xl border border-blue-500/40 bg-[#131519] p-6 flex flex-col justify-between shadow-xl relative overflow-hidden group">
        <div>
          <div class="flex items-center justify-between gap-3 mb-4">
            <span class="font-mono text-4xl sm:text-5xl font-extrabold text-blue-500 tracking-tighter">
              #01
            </span>
            <VerdictBadge verdict={rankOne.verdict} size="sm" />
          </div>

          <h3 class="text-xl sm:text-2xl font-extrabold text-white group-hover:text-blue-400 transition-colors mb-2">
            <a href={`/tools/${rankOne.slug}`} class="hover:underline">
              {rankOne.name}
            </a>
          </h3>
          <span class="text-micro text-app-subtle font-mono block mb-3">
            {rankOne.repo}
          </span>

          <p class="text-xs sm:text-sm text-app-muted leading-relaxed mb-6">
            {rankOne.tagline}
          </p>

          <!-- Why is this #1 Deciding Sub-Score (Tinted, no extra border) -->
          <div class="p-3.5 rounded-lg bg-[#0A0B0E] mb-6 font-mono text-xs space-y-1">
            <span class="text-micro text-blue-400 block">DECIDING BENCHMARK</span>
            <div class="font-bold text-white flex items-center justify-between">
              <span class="text-app-muted font-normal">{getDecidingFactor(rankOne)}</span>
              <span class="text-white font-mono text-sm">{rankOne.safety_score}/100</span>
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-app-border flex items-center justify-between font-mono text-xs text-app-subtle">
          <span>★ {rankOne.stars.toLocaleString()} · Scanned {rankOne.scanned_at.split('T')[0]}</span>
          <a href={`/tools/${rankOne.slug}`} class="text-blue-400 hover:text-blue-300 font-semibold inline-flex items-center gap-1.5 transition-colors">
            <span>Read Audit Report</span>
            <svg class="w-3.5 h-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </a>
        </div>
      </div>
    )}

    <!-- RANKS 2-5: COMPACT ROWS (7 cols) -->
    <div class="lg:col-span-7 space-y-3">
      {ranksTwoToFive.map((tool, idx) => {
        const rankNum = `#0${idx + 2}`;

        return (
          <a
            href={`/tools/${tool.slug}`}
            class="group flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 rounded-xl border border-app-border bg-[#131519] hover:bg-app-surface-hover hover:border-blue-500/30 transition-all duration-150"
          >
            <div class="flex items-center gap-4 min-w-0">
              <span class="font-mono text-xl sm:text-2xl font-bold text-app-subtle group-hover:text-blue-400 transition-colors w-10 shrink-0">
                {rankNum}
              </span>

              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <h4 class="font-bold text-sm text-white group-hover:text-blue-400 transition-colors truncate">
                    {tool.name}
                  </h4>
                  <span class="text-[10px] font-mono text-app-subtle">{tool.repo}</span>
                </div>
                <p class="text-xs text-app-muted truncate mt-0.5 max-w-md font-sans">
                  {tool.tagline}
                </p>
                <div class="text-[10px] font-mono text-app-subtle mt-1 flex items-center gap-2">
                  <span>Benchmark: {getDecidingFactor(tool)}</span>
                  <span>·</span>
                  <span>Scanned {tool.scanned_at.split('T')[0]}</span>
                </div>
              </div>
            </div>

            <div class="flex items-center gap-3 shrink-0 self-end sm:self-center font-mono">
              <div class="text-right">
                <div class="font-bold text-base text-white">{tool.safety_score}</div>
                <div class="text-[9px] text-app-subtle">/100</div>
              </div>
              <VerdictBadge verdict={tool.verdict} size="sm" />
            </div>
          </a>
        );
      })}

      <!-- View All Link -->
      <div class="pt-2 text-right">
        <a
          href="/#categories"
          class="text-xs font-mono text-blue-400 hover:text-blue-300 transition-colors inline-flex items-center gap-1.5"
        >
          <span>View all 39 audited repositories</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</section>
