---
import type { ToolAudience as AudienceType } from '../types/tool';

interface Props {
  audience: AudienceType;
  class?: string;
}

const { audience, class: className = '' } = Astro.props;
---

<div class={`grid grid-cols-1 md:grid-cols-2 gap-4 ${className}`}>
  <!-- Column 1: Perfect For (Green Accents) -->
  <div class="p-4 rounded-xl border border-emerald-500/30 bg-[#0A0B0E] flex flex-col justify-between">
    <div>
      <div class="flex items-center gap-2 mb-3 pb-2 border-b border-emerald-500/20">
        <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12" />
        </svg>
        <h4 class="font-mono text-xs font-bold text-emerald-400 uppercase tracking-wider">
          Perfect For
        </h4>
      </div>

      <ul class="space-y-2.5 text-xs text-app-text">
        {audience.perfectFor.map((item) => (
          <li class="flex items-start gap-2 leading-relaxed">
            <span class="text-emerald-400 font-bold shrink-0 mt-0.5">•</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Column 2: Skip It If (Honest Warning Accents) -->
  <div class="p-4 rounded-xl border border-amber-500/30 bg-[#0A0B0E] flex flex-col justify-between">
    <div>
      <div class="flex items-center gap-2 mb-3 pb-2 border-b border-amber-500/20">
        <svg class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
        <h4 class="font-mono text-xs font-bold text-amber-400 uppercase tracking-wider">
          Skip It If
        </h4>
      </div>

      <ul class="space-y-2.5 text-xs text-app-muted">
        {audience.skipIf.map((item) => (
          <li class="flex items-start gap-2 leading-relaxed">
            <span class="text-amber-400 font-bold shrink-0 mt-0.5">•</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

