---
import type { CategoryData } from '../types/tool';
import Activity from 'lucide-astro/Activity';
import Shield from 'lucide-astro/Shield';
import PlayCircle from 'lucide-astro/PlayCircle';
import Cloud from 'lucide-astro/Cloud';
import FileText from 'lucide-astro/FileText';
import Home from 'lucide-astro/Home';
import BarChart2 from 'lucide-astro/BarChart2';
import Code2 from 'lucide-astro/Code2';
import Database from 'lucide-astro/Database';
import Network from 'lucide-astro/Network';
import Cpu from 'lucide-astro/Cpu';
import Image from 'lucide-astro/Image';
import DollarSign from 'lucide-astro/DollarSign';
import Bot from 'lucide-astro/Bot';
import Folder from 'lucide-astro/Folder';

interface Props {
  category: CategoryData;
  toolCount: number;
  avgScore: number;
  class?: string;
}

const { category, toolCount, avgScore, class: className = '' } = Astro.props;

// Per-category icon from src/data/categories.ts (`icon` field)
const iconMap: Record<string, any> = {
  Activity, Shield, PlayCircle, Cloud, FileText, Home, BarChart2,
  Code2, Database, Network, Cpu, Image, DollarSign, Bot,
};
const Icon = iconMap[category.icon] || Folder;
---

<a
  href={`/categories/${category.slug}`}
  class={`group block rounded-xl border border-app-border bg-app-surface p-4 sm:p-5 hover:border-app-border-hover hover:bg-app-surface-hover transition-all duration-150 ${className}`}
>
  <div class="flex items-start justify-between gap-2.5 sm:gap-3 mb-2.5">
    <div class="flex items-center gap-2.5 min-w-0 flex-1">
      <div class="w-8 h-8 rounded-lg bg-app-bg border border-app-border flex items-center justify-center text-blue-400 group-hover:text-blue-300 shrink-0">
        <Icon class="w-4 h-4" aria-hidden="true" />
      </div>
      <div class="min-w-0 flex-1">
        <h3 class="font-semibold text-sm sm:text-base text-app-text group-hover:text-blue-400 transition-colors truncate">
          {category.name}
        </h3>
        <span class="text-micro text-app-subtle block truncate">
          {toolCount} {toolCount === 1 ? 'tool' : 'tools'} evaluated
        </span>
      </div>
    </div>

    <div class="text-right shrink-0 pl-1">
      <span class="text-micro text-app-subtle block">Avg Score</span>
      <span class="font-mono font-bold text-xs sm:text-sm text-emerald-400">
        {Math.round(avgScore)}<span class="text-app-subtle font-normal text-xs">/100</span>
      </span>
    </div>
  </div>

  <p class="text-xs text-app-muted line-clamp-2 leading-relaxed">
    {category.tagline}
  </p>
</a>
