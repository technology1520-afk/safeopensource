---
import type { CategoryData } from '../types/tool';

interface Props {
  category: CategoryData;
  toolCount: number;
  avgScore: number;
  class?: string;
}

const { category, toolCount, avgScore, class: className = '' } = Astro.props;
---

<a
  href={`/categories/${category.slug}`}
  class={`group block rounded-xl border border-app-border bg-app-surface p-5 hover:border-app-border-hover hover:bg-app-surface-hover transition-all duration-150 ${className}`}
>
  <div class="flex items-start justify-between gap-3 mb-2.5">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-lg bg-app-bg border border-app-border flex items-center justify-center text-blue-400 group-hover:text-blue-300">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
        </svg>
      </div>
      <div>
        <h3 class="font-semibold text-sm text-app-text group-hover:text-blue-400 transition-colors">
          {category.name}
        </h3>
        <span class="text-micro text-app-subtle">
          {toolCount} {toolCount === 1 ? 'tool' : 'tools'} evaluated
        </span>
      </div>
    </div>

    <div class="text-right">
      <span class="text-micro text-app-subtle block">Avg Score</span>
      <span class="font-mono font-bold text-xs text-emerald-400">
        {Math.round(avgScore)}<span class="text-app-subtle font-normal">/100</span>
      </span>
    </div>
  </div>

  <p class="text-xs text-app-muted line-clamp-2 leading-relaxed">
    {category.tagline}
  </p>
</a>

