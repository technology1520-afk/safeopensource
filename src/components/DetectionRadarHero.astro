---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

// Flagged and healthy repo ping targets
const targets = [
  { name: 'huginn', angle: 45, radius: 130, color: '#EF4444', label: 'huginn (42.0 - DORMANT)', isFlagged: true },
  { name: 'statping-ng', angle: 120, radius: 110, color: '#F59E0B', label: 'statping-ng (56.0 - BUS FACTOR)', isFlagged: true },
  { name: 'jellyfin', angle: 210, radius: 155, color: '#10B981', label: 'jellyfin (91.8 - VERIFIED)', isFlagged: false },
  { name: 'vaultwarden', angle: 290, radius: 165, color: '#10B981', label: 'vaultwarden (95.0 - AUDITED)', isFlagged: false },
  { name: 'owncloud', angle: 340, radius: 95, color: '#F59E0B', label: 'owncloud (63.0 - LEGACY)', isFlagged: true }
];
---

<div class={`w-full max-w-3xl mx-auto ${className}`} id="detection-radar-hero">
  <div class="rounded-xl border border-app-border bg-[#0a0c10] shadow-2xl p-6 sm:p-8 relative overflow-hidden">
    <!-- Top Telemetry Header -->
    <div class="flex items-center justify-between pb-4 border-b border-app-border text-xs font-mono">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-blue-500 animate-ping"></span>
        <span class="text-blue-400 font-bold uppercase tracking-wider text-[11px]">
          DIRECTION B: DETECTION RADAR SWEEP
        </span>
      </div>
      <span class="text-app-subtle text-[10px] hidden sm:inline-block">
        FREQ: 1420 MHZ // AZIMUTH: CONTINUOUS
      </span>
    </div>

    <!-- Center SVG Radar Screen -->
    <div class="relative w-[280px] h-[280px] sm:w-[340px] sm:h-[340px] mx-auto my-6 flex items-center justify-center">
      <svg
        viewBox="0 0 360 360"
        class="w-full h-full select-none"
        aria-label="Detection Radar Screen"
      >
        <defs>
          <!-- Sweep Gradient Cone -->
          <linearGradient id="sweep-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#3B82F6" stop-opacity="0.4" />
            <stop offset="50%" stop-color="#3B82F6" stop-opacity="0.1" />
            <stop offset="100%" stop-color="#3B82F6" stop-opacity="0" />
          </linearGradient>
        </defs>

        <!-- Concentric Range Circles -->
        <circle cx="180" cy="180" r="160" fill="none" stroke="#23262E" stroke-width="1.5" />
        <circle cx="180" cy="180" r="120" fill="none" stroke="#23262E" stroke-width="1" stroke-dasharray="3 3" />
        <circle cx="180" cy="180" r="80" fill="none" stroke="#23262E" stroke-width="1" stroke-dasharray="2 2" />
        <circle cx="180" cy="180" r="40" fill="none" stroke="#23262E" stroke-width="1" />

        <!-- Crosshair Axes -->
        <line x1="180" y1="10" x2="180" y2="350" stroke="#1c1f26" stroke-width="1" />
        <line x1="10" y1="180" x2="350" y2="180" stroke="#1c1f26" stroke-width="1" />

        <!-- Rotating Sweep Beam -->
        <g class="radar-sweep-beam origin-[180px_180px]">
          <line x1="180" y1="180" x2="180" y2="20" stroke="#60A5FA" stroke-width="2" opacity="0.9" />
          <path
            d="M180,180 L180,20 A160,160 0 0,0 66,66 Z"
            fill="url(#sweep-gradient)"
            opacity="0.7"
          />
        </g>

        <!-- Center Hub -->
        <circle cx="180" cy="180" r="4" fill="#60A5FA" />

        <!-- Plotted Targets -->
        {targets.map((t) => {
          const rad = ((t.angle - 90) * Math.PI) / 180;
          const tx = 180 + t.radius * Math.cos(rad);
          const ty = 180 + t.radius * Math.sin(rad);

          return (
            <g class="target-node" data-target={t.name}>
              {t.isFlagged && (
                <circle
                  cx={tx}
                  cy={ty}
                  r="12"
                  fill="none"
                  stroke={t.color}
                  stroke-width="1.5"
                  class="animate-ping opacity-75 origin-[center]"
                />
              )}
              <circle
                cx={tx}
                cy={ty}
                r="5"
                fill={t.color}
                stroke="#0A0B0E"
                stroke-width="2"
              />
              <text
                x={tx + 8}
                y={ty + 3}
                fill={t.color}
                font-family="monospace"
                font-size="8"
                font-weight="bold"
              >
                {t.name.toUpperCase()}
              </text>
            </g>
          );
        })}
      </svg>
    </div>

    <!-- Telemetry Readout Strip -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-4 border-t border-app-border font-mono text-xs text-app-muted">
      <div class="p-2.5 rounded-lg bg-app-surface border border-app-border">
        <span class="text-micro text-app-subtle block mb-0.5">Threat Detection</span>
        <span class="text-rose-400 font-bold">3 REPOS FLAGGED</span>
      </div>
      <div class="p-2.5 rounded-lg bg-app-surface border border-app-border">
        <span class="text-micro text-app-subtle block mb-0.5">Sweep Velocity</span>
        <span class="text-app-text font-bold">4.2 REPOS/SEC</span>
      </div>
      <div class="p-2.5 rounded-lg bg-app-surface border border-app-border">
        <span class="text-micro text-app-subtle block mb-0.5">Healthy Ratio</span>
        <span class="text-emerald-400 font-bold">87.2% NOMINAL</span>
      </div>
    </div>
  </div>
</div>

<style>
  .radar-sweep-beam {
    animation: radar-sweep 4s linear infinite;
    transform-origin: 180px 180px;
  }

  @keyframes radar-sweep {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .radar-sweep-beam {
      animation: none !important;
      transform: rotate(45deg);
    }
  }
</style>
