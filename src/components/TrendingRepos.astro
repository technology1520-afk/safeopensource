---
import { getTrendingByFilter, type TrendingItem } from '../data/trending';
import VerdictBadge from './VerdictBadge.astro';

interface Props {
  activeFilter?: 'velocity' | 'new-entrants' | 'score-drops';
  class?: string;
}

const { activeFilter = 'velocity', class: className = '' } = Astro.props;
const items: TrendingItem[] = getTrendingByFilter(activeFilter);

// Calculate honest 7-point SVG sparkline with area fill, coordinates, and endpoints
function getSparklineData(points: number[], width = 220, height = 48) {
  if (!points || points.length === 0) {
    return { path: '', areaPath: '', endX: 0, endY: 0, minVal: 0, maxVal: 0, firstVal: 0, lastVal: 0, coords: [], isPositive: true };
  }

  const min = Math.min(...points);
  const max = Math.max(...points);
  const range = max - min === 0 ? 1 : max - min;
  const paddingY = 8;
  const usableH = height - paddingY * 2;
  const stepX = width / (points.length - 1);

  const coords = points.map((val, idx) => {
    const x = Math.round(idx * stepX);
    const y = Math.round(height - paddingY - ((val - min) / range) * usableH);
    return { x, y, val };
  });

  const path = `M ${coords.map((c) => `${c.x},${c.y}`).join(' L ')}`;
  const areaPath = `${path} L ${width},${height} L 0,${height} Z`;
  const isPositive = points[points.length - 1] >= points[0];
  const lastCoord = coords[coords.length - 1];

  return {
    path,
    areaPath,
    endX: lastCoord.x,
    endY: lastCoord.y,
    minVal: min,
    maxVal: max,
    firstVal: points[0],
    lastVal: points[points.length - 1],
    coords,
    isPositive
  };
}

function formatScanDate(isoDate: string): string {
  try {
    const d = new Date(isoDate);
    return d.toISOString().split('T')[0];
  } catch {
    return isoDate;
  }
}

// Check if we should append a ghost card to balance grid (e.g. 4 cards in 3-col grid leaves 2 empty cells)
const showGhostCard = items.length % 3 !== 0;
---

<section class={`my-14 rounded-2xl border border-app-border bg-[#0a0c10] p-6 sm:p-8 scroll-mt-24 ${className}`} id="trending">
  <!-- Section Title & Real Filter Tabs -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-app-border mb-6">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-micro text-emerald-400">TELEMETRY MOMENTUM & DRIFT</span>
      </div>
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-app-text">
        Trending Repositories
      </h2>
      <p class="text-xs text-app-muted mt-1 leading-relaxed">
        Velocity and volatility over raw popularity. Continuous 7-day drift tracking identifying rapid security hardening and supply-chain regressions.
      </p>
    </div>

    <!-- Navigation Filter Tabs with Real URLs -->
    <nav class="flex items-center gap-1.5 p-1 rounded-xl bg-[#131519] border border-app-border font-mono text-xs" aria-label="Trending filter tabs">
      <a
        href="/trending"
        class={`px-3 py-1.5 rounded-lg transition-colors ${
          activeFilter === 'velocity'
            ? 'bg-blue-600 text-white font-medium shadow-xs'
            : 'text-app-muted hover:text-white hover:bg-app-surface'
        }`}
      >
        Velocity (7d)
      </a>
      <a
        href="/trending/new-entrants"
        class={`px-3 py-1.5 rounded-lg transition-colors ${
          activeFilter === 'new-entrants'
            ? 'bg-blue-600 text-white font-medium shadow-xs'
            : 'text-app-muted hover:text-white hover:bg-app-surface'
        }`}
      >
        New Entrants
      </a>
      <a
        href="/trending/score-drops"
        class={`px-3 py-1.5 rounded-lg transition-colors ${
          activeFilter === 'score-drops'
            ? 'bg-blue-600 text-white font-medium shadow-xs'
            : 'text-app-muted hover:text-white hover:bg-app-surface'
        }`}
      >
        Score Drops (Risks)
      </a>
    </nav>
  </div>

  <!-- Cards Grid (Single-stroke containers, no box-in-box-in-box) -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {items.map((item) => {
      const hasTelemetry = item.momentum !== null;
      const spark = hasTelemetry ? getSparklineData(item.momentum!.sparkline) : null;
      const isNegative = hasTelemetry && item.momentum!.scoreDelta < 0;
      const strokeColor = isNegative ? '#EF4444' : '#10B981';
      const gradId = `spark-grad-${item.slug}`;

      return (
        <article class="rounded-xl border border-app-border bg-[#131519] p-6 flex flex-col justify-between hover:border-blue-500/40 transition-all duration-150 group">
          <div>
            <!-- Header Row: Name & Verdict -->
            <div class="flex items-start justify-between gap-3 mb-2">
              <div class="min-w-0">
                <h3 class="text-base font-bold text-app-text group-hover:text-blue-400 transition-colors truncate">
                  <a href={`/tools/${item.slug}`} class="hover:underline">
                    {item.name}
                  </a>
                </h3>
                <span class="text-xs font-mono text-app-subtle truncate block mt-0.5">
                  {item.repo}
                </span>
              </div>
              <VerdictBadge verdict={item.verdict} size="sm" />
            </div>

            <!-- Tagline (Prose in clean Sans font) -->
            <p class="text-xs text-app-muted leading-relaxed line-clamp-2 mb-4 font-sans">
              {item.tagline}
            </p>

            <!-- HERO SCORE SECTION: Absolute Safety Score is the hero number (28–32px mono) -->
            <div class="mb-4">
              <span class="text-[10px] font-mono text-app-subtle uppercase tracking-wider block mb-1">
                COMPOSITE SAFETY SCORE
              </span>
              <div class="flex items-baseline justify-between gap-2">
                <div class="flex items-baseline gap-1">
                  <span class="font-mono text-3xl font-extrabold text-white tracking-tight">
                    {item.safetyScore.toFixed(1)}
                  </span>
                  <span class="font-mono text-xs text-app-subtle">/100</span>
                </div>

                <!-- Secondary Drift Status Chip -->
                {hasTelemetry && (
                  <div class={`inline-flex items-center gap-1 px-2 py-0.5 rounded font-mono text-[11px] font-bold ${
                    isNegative
                      ? 'bg-rose-950/40 text-rose-400 border border-rose-500/30'
                      : 'bg-emerald-950/40 text-emerald-400 border border-emerald-500/30'
                  }`}>
                    {isNegative ? (
                      <svg class="w-3 h-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9" />
                      </svg>
                    ) : (
                      <svg class="w-3 h-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="18 15 12 9 6 15" />
                      </svg>
                    )}
                    <span>{item.momentum!.scoreDelta > 0 ? '+' : ''}{item.momentum!.scoreDelta.toFixed(1)} pts 7d</span>
                  </div>
                )}
              </div>
            </div>

            <!-- HONEST SPARKLINE INSTRUMENT (Tinted container, no extra border) -->
            {hasTelemetry && spark ? (
              <div class="p-3.5 rounded-lg bg-[#0A0B0E] space-y-2 mb-4">
                <div class="flex items-center justify-between text-[10px] font-mono text-app-subtle">
                  <a
                    href="/how-we-score#cadence"
                    class="hover:text-blue-400 underline decoration-dotted transition-colors"
                    title="7-point weekly scan cadence measuring metric volatility and commit vitality"
                  >
                    7-Point Scan Cadence ℹ
                  </a>
                  <span>Start: <strong class="text-white">{spark.firstVal.toFixed(1)}</strong> &rarr; Now: <strong class={isNegative ? 'text-rose-400' : 'text-emerald-400'}>{spark.lastVal.toFixed(1)}</strong></span>
                </div>

                <!-- SVG Sparkline with Area Fill and End-Dot -->
                <div class="relative w-full h-12">
                  <svg
                    viewBox="0 0 220 48"
                    class="w-full h-full overflow-visible"
                    preserveAspectRatio="none"
                    aria-label={`7-week score trend from ${spark.firstVal} to ${spark.lastVal}`}
                  >
                    <defs>
                      <linearGradient id={gradId} x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color={strokeColor} stop-opacity="0.25" />
                        <stop offset="100%" stop-color={strokeColor} stop-opacity="0.0" />
                      </linearGradient>
                    </defs>

                    <!-- Horizontal Grid Baseline -->
                    <line x1="0" y1="47" x2="220" y2="47" stroke="#23262E" stroke-width="1" stroke-dasharray="2 2" />

                    <!-- Area Fill -->
                    <path d={spark.areaPath} fill={`url(#${gradId})`} />

                    <!-- Main Curve Line -->
                    <path
                      d={spark.path}
                      stroke={strokeColor}
                      stroke-width="2"
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />

                    <!-- End-Dot Circle at Final Point -->
                    <circle
                      cx={spark.endX}
                      cy={spark.endY}
                      r="3.5"
                      fill={strokeColor}
                      stroke="#0A0B0E"
                      stroke-width="1.5"
                    />
                  </svg>
                </div>

                <!-- Labeled 7-point X-Axis Timeline -->
                <div class="flex items-center justify-between text-[9px] font-mono text-app-subtle/80 pt-1 border-t border-app-border/40">
                  <span>W-6</span>
                  <span>W-5</span>
                  <span>W-4</span>
                  <span>W-3</span>
                  <span>W-2</span>
                  <span>W-1</span>
                  <span class="text-app-text font-bold">Now</span>
                </div>

                <!-- Delta Reason Note (Neutral Gray - Green strictly constrained to status) -->
                {item.momentum!.deltaReason && (
                  <p class="text-xs text-app-muted leading-relaxed pt-1.5 border-t border-app-border/40 font-sans">
                    {item.momentum!.deltaReason}
                  </p>
                )}
              </div>
            ) : (
              /* Honest Zero-State: Repo added recently, never fake trends */
              <div class="p-4 rounded-lg bg-[#0A0B0E] border border-dashed border-app-border mb-4 font-mono">
                <div class="flex items-center gap-2 mb-1.5">
                  <span class="w-2 h-2 rounded-full bg-blue-400 animate-ping"></span>
                  <span class="text-xs text-blue-400 font-bold uppercase tracking-wider">Recently Added to Watchlist</span>
                </div>
                <p class="text-xs text-app-muted leading-relaxed font-sans mb-2">
                  Baseline telemetry calibration in progress. Synthetic curves are strictly banned until 7 consecutive weekly audits complete.
                </p>
                <div class="flex items-center justify-between text-[10px] text-app-subtle pt-2 border-t border-app-border/40">
                  <span>First audit: {formatScanDate(item.scannedAt)}</span>
                  <span class="text-blue-400 font-semibold">Calibrating</span>
                </div>
              </div>
            )}
          </div>

          <!-- Bottom Footer: Freshness Timestamps & Verifiable Audit Link -->
          <div class="pt-4 border-t border-app-border flex items-center justify-between font-mono text-xs">
            <div class="text-[10px] text-app-subtle leading-tight">
              <span class="block">Last sweep 2h ago</span>
              <span>Scanned {formatScanDate(item.scannedAt)}</span>
            </div>

            <a
              href={`/tools/${item.slug}`}
              class="text-blue-400 hover:text-blue-300 font-semibold inline-flex items-center gap-1.5 transition-colors group/link"
            >
              <svg class="w-3.5 h-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              </svg>
              <span>View Security Audit</span>
              <svg class="w-3 h-3 stroke-current group-hover/link:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
          </div>
        </article>
      );
    })}

    <!-- Intentional 5th Tile: "Browse all 39 tools →" ghost card to eliminate dead cells -->
    {showGhostCard && (
      <aside class="rounded-xl border border-dashed border-app-border hover:border-blue-500/50 bg-[#0A0B0E]/60 hover:bg-[#131519] p-6 flex flex-col justify-between transition-all duration-200 group">
        <div>
          <div class="w-10 h-10 rounded-xl bg-blue-950/40 border border-blue-500/30 flex items-center justify-center text-blue-400 mb-4 group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7" />
              <rect x="14" y="3" width="7" height="7" />
              <rect x="14" y="14" width="7" height="7" />
              <rect x="3" y="14" width="7" height="7" />
            </svg>
          </div>

          <span class="text-micro text-blue-400 font-mono block mb-1">
            COMPLETE WATCHLIST REGISTRY
          </span>
          <h3 class="text-lg font-bold text-white mb-2 group-hover:text-blue-400 transition-colors">
            Browse All 39 Cataloged Tools
          </h3>
          <p class="text-xs text-app-muted leading-relaxed font-sans mb-6">
            Filter all 39 audited open-source projects across 13 sectors with deterministic 0–100 Safety Scores, license obligations, and supply-chain telemetry.
          </p>

          <div class="space-y-2 text-xs font-mono text-app-subtle mb-6">
            <div class="flex items-center justify-between pb-1 border-b border-app-border/40">
              <span>Monitored Taxonomies:</span>
              <span class="text-white font-bold">13 Sectors</span>
            </div>
            <div class="flex items-center justify-between pb-1 border-b border-app-border/40">
              <span>Automated Sweeps:</span>
              <span class="text-emerald-400 font-bold">Weekly Cadence</span>
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-app-border/60 flex items-center justify-between font-mono text-xs">
          <span class="text-[10px] text-app-subtle">No Pay-for-Rankings</span>
          <a
            href="/#categories"
            class="px-3.5 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-bold inline-flex items-center gap-1.5 transition-colors shadow-xs"
          >
            <span>Explore All Repos</span>
            <svg class="w-3.5 h-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </a>
        </div>
      </aside>
    )}
  </div>
</section>
