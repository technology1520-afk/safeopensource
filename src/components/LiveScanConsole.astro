---
import { getTelemetryStats } from '../utils/telemetry';
import { getRecentPublicScans } from '../lib/scanner/pipeline';
import VerdictBadge from './VerdictBadge.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const telemetry = getTelemetryStats();
const recentScans = getRecentPublicScans(5);
---

<div class={`w-full max-w-3xl mx-auto scroll-mt-24 ${className}`} id="telemetry-status-container">
  <div class="rounded-xl border border-app-border bg-app-surface shadow-2xl overflow-hidden">
    <!-- Window Bar -->
    <div class="flex items-center justify-between px-4 py-2.5 bg-app-surface-2 border-b border-app-border font-mono text-[11px]">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80 inline-block"></span>
        <span class="text-app-subtle tracking-wider uppercase font-bold text-app-text">
          CONTINUOUS TELEMETRY MONITOR
        </span>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/scan"
          class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-blue-600/20 text-blue-400 hover:bg-blue-600 border border-blue-500/30 text-[10px] font-mono font-semibold transition-colors"
        >
          <span>+ Scan Any Repo</span>
        </a>
      </div>
    </div>

    <!-- Telemetry List -->
    <div class="p-4 sm:p-5 font-mono text-xs text-app-text space-y-2 bg-app-bg/80">
      <div class="text-[11px] text-app-subtle mb-3 flex items-center justify-between border-b border-app-border/40 pb-2">
        <span>RECENT TELEMETRY VERIFICATIONS</span>
        <span class="text-emerald-400 font-bold">100% CORROBORATED</span>
      </div>

      <div class="space-y-1.5">
        {recentScans.map((item) => (
          <a
            href={`/tools/${item.slug}`}
            class="flex items-center justify-between gap-2 py-1.5 px-2.5 rounded hover:bg-app-surface-2 transition-colors group"
          >
            <div class="flex items-center gap-2 min-w-0">
              <span class="text-app-subtle group-hover:text-blue-400">▸</span>
              <span class="font-medium text-app-text group-hover:text-blue-400 transition-colors truncate">
                {item.repo}
              </span>
            </div>

            <div class="flex items-center gap-3 shrink-0">
              <span class="font-bold text-app-text">{Math.round(item.safety_score)}</span>
              <VerdictBadge verdict={item.verdict} size="sm" />
              <span class="text-app-subtle text-[10px] hidden md:inline-block font-mono">
                [{item.license_spdx}]
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Console Footer Stats Strip -->
    <div class="px-4 py-2.5 bg-app-surface-2 border-t border-app-border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 font-mono text-[11px] text-app-muted">
      <div class="flex items-center gap-3">
        <span class="flex items-center gap-1.5 text-app-text font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>{telemetry.totalWatched} repos cataloged</span>
        </span>
        <span class="text-app-subtle">&middot;</span>
        <span class="text-rose-400 font-medium">{telemetry.flaggedCount} flagged</span>
      </div>

      <div class="text-app-subtle text-[10px] uppercase tracking-wider">
        DETERMINISTIC METRICS // ZERO SIMULATION
      </div>
    </div>
  </div>
</div>
