---
import type { ToolData } from '../types/tool';
import ScoreRing from './ScoreRing.astro';
import VerdictBadge from './VerdictBadge.astro';

interface Props {
  tools: ToolData[];
  class?: string;
}

const { tools, class: className = '' } = Astro.props;
---

<div class={`grid grid-cols-1 md:grid-cols-3 gap-4 ${className}`}>
  {tools.map((tool, index) => (
    <a
      href={`/tools/${tool.slug}`}
      class={`group relative flex flex-col justify-between rounded-xl border border-app-border bg-app-surface p-6 hover:border-blue-500/40 hover:bg-app-surface-hover transition-all duration-150 ${
        index === 0 ? 'md:border-blue-500/30' : ''
      }`}
    >
      <div>
        <div class="flex items-center justify-between gap-3 mb-4">
          <span class="text-micro text-emerald-400 font-mono flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>Rank #{index + 1} Safest</span>
          </span>
          <VerdictBadge verdict={tool.verdict} size="sm" />
        </div>

        <div class="flex items-start justify-between gap-4 mb-4">
          <div>
            <h3 class="font-bold text-lg text-app-text group-hover:text-blue-400 transition-colors">
              {tool.name}
            </h3>
            <span class="text-micro text-app-subtle block mt-0.5">
              {tool.category}
            </span>
          </div>

          <div class="shrink-0">
            <ScoreRing score={tool.safety_score} size="md" animate={false} />
          </div>
        </div>

        <p class="text-xs text-app-muted leading-relaxed line-clamp-3 mb-6">
          {tool.tagline}
        </p>
      </div>

      <div class="pt-4 border-t border-app-border flex items-center justify-between text-xs font-mono text-app-subtle">
        <span class="flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-amber-400/80 shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
          </svg>
          <span>{tool.stars.toLocaleString()} stars</span>
        </span>

        <span class="text-app-text hover:text-blue-400 inline-flex items-center gap-1">
          <span>Read Scan</span>
          <span aria-hidden="true">&rarr;</span>
        </span>
      </div>
    </a>
  ))}
</div>

