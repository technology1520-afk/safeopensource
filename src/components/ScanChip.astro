---
import { formatScanTimestamp } from '../lib/scanner/scoring';

interface Props {
  scannedAt: string;
  repo: string;
  slug: string;
  class?: string;
}

const { scannedAt, repo, slug, class: className = '' } = Astro.props;

const timestampUtc = formatScanTimestamp(scannedAt);
---

<div class={`inline-flex items-center flex-wrap gap-2 text-xs text-app-muted ${className}`}>
  <span
    class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-950/40 border border-emerald-500/30 font-mono text-[11px] text-emerald-400"
    title={timestampUtc}
  >
    <span class="relative flex h-2 w-2">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
    </span>
    <span>{timestampUtc}</span>
  </span>

  <a
    href={`https://github.com/${repo}`}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-app-surface hover:bg-app-surface-hover border border-app-border text-[11px] font-mono text-app-text hover:text-blue-400 transition-colors"
  >
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
      <path d="M9 18c-4.51 2-5-2-7-2" />
    </svg>
    <span>View Repo</span>
  </a>

  <a
    href={`/data/tools/${slug}.json`}
    target="_blank"
    class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-app-surface hover:bg-app-surface-hover border border-app-border text-[11px] font-mono text-app-muted hover:text-app-text transition-colors"
  >
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
      <polyline points="14 2 14 8 20 8" />
      <line x1="16" y1="13" x2="8" y2="13" />
      <line x1="16" y1="17" x2="8" y2="17" />
      <polyline points="10 9 9 9 8 9" />
    </svg>
    <span>Raw JSON Data</span>
  </a>
</div>

