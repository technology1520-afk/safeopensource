---
import { starterKits } from '../data/starter-kits';
import { getToolBySlug } from '../utils/tools';
import VerdictBadge from './VerdictBadge.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

// Enrich kits with tools and calculate combined safety rating + lowest tool warning
const enrichedKits = starterKits.map((kit) => {
  const tools = kit.tools.map((slug) => getToolBySlug(slug)).filter(Boolean);
  
  const avgScore = tools.length > 0
    ? Math.round(tools.reduce((acc, t) => acc + (t?.safety_score || 0), 0) / tools.length)
    : 0;

  // Find lowest scoring tool in the bundle
  const lowestTool = tools.length > 0
    ? [...tools].sort((a, b) => (a?.safety_score || 0) - (b?.safety_score || 0))[0]
    : null;

  const hasWarning = lowestTool && lowestTool.safety_score < 80;

  return {
    ...kit,
    resolvedTools: tools,
    avgScore,
    lowestTool,
    hasWarning
  };
});
---

<section class={`my-14 rounded-2xl border border-app-border bg-[#0a0c10] p-6 sm:p-8 ${className}`} id="recommendations">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-app-border mb-8">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="w-2 h-2 rounded-full bg-blue-500"></span>
        <span class="text-micro text-blue-400">RECOMMENDED ARCHITECTURAL BUNDLES</span>
      </div>
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-app-text">
        The Right Stack for You
      </h2>
      <p class="text-xs text-app-muted mt-1 leading-relaxed">
        Pre-audited multi-tool blueprints. Each bundle is mathematically evaluated for combined reliability, shared dependencies, and resource limits.
      </p>
    </div>

    <a
      href="/starter-kits"
      class="text-xs font-mono text-blue-400 hover:text-blue-300 transition-colors inline-flex items-center gap-1.5 self-start sm:self-center"
    >
      <span>Browse all blueprints</span>
      <span>&rarr;</span>
    </a>
  </div>

  <!-- Bundles Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {enrichedKits.map((kit) => (
      <div class="rounded-xl border border-app-border bg-[#131519] p-6 flex flex-col justify-between hover:border-blue-500/40 transition-all duration-200 group">
        <div>
          <!-- Top Badges Row -->
          <div class="flex items-center justify-between gap-2 mb-3">
            <span class={`text-micro px-2.5 py-0.5 rounded-full border font-mono font-bold ${
              kit.difficulty === 'Beginner'
                ? 'border-emerald-500/40 text-emerald-400 bg-emerald-950/20'
                : kit.difficulty === 'Intermediate'
                ? 'border-blue-500/40 text-blue-400 bg-blue-950/20'
                : 'border-purple-500/40 text-purple-400 bg-purple-950/20'
            }`}>
              {kit.difficulty}
            </span>

            <div class="flex items-center gap-2 text-micro font-mono text-app-subtle">
              <span>⏱ {kit.estimated_time}</span>
              <span>·</span>
              <span class="text-app-text font-semibold">{kit.total_ram || '2 GB RAM'}</span>
            </div>
          </div>

          <!-- Bundle Title -->
          <h3 class="text-lg font-bold text-app-text group-hover:text-blue-400 transition-colors mb-2">
            <a href={`/starter-kits#${kit.slug}`}>
              {kit.title}
            </a>
          </h3>

          <p class="text-xs text-app-muted leading-relaxed line-clamp-2 mb-5">
            {kit.tagline}
          </p>

          <!-- Combined Safety Index Block -->
          <div class="p-3.5 rounded-lg bg-[#0A0B0E] border border-app-border mb-5">
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-[10px] font-mono text-app-subtle">COMBINED STACK SAFETY</span>
              <span class="font-mono text-sm font-bold text-emerald-400">
                {kit.avgScore}/100
              </span>
            </div>

            <!-- Lowest Score Warning Indicator if applicable -->
            {kit.hasWarning && kit.lowestTool ? (
              <div class="flex items-center gap-1.5 text-[11px] font-mono text-amber-400 pt-1 border-t border-app-border">
                <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                  <line x1="12" y1="9" x2="12" y2="13" />
                  <line x1="12" y1="17" x2="12.01" y2="17" />
                </svg>
                <span class="truncate">Lowest component: {kit.lowestTool.name} ({kit.lowestTool.safety_score})</span>
              </div>
            ) : (
              <div class="text-[10px] font-mono text-emerald-400/80 pt-1 border-t border-app-border flex items-center gap-1">
                <span>✓ All components verified healthy & supply-chain screened</span>
              </div>
            )}
          </div>

          <!-- Included Stack Tools Mini Strip -->
          <div class="space-y-2 mb-6">
            <span class="text-[10px] font-mono text-app-subtle uppercase tracking-wider block">
              Included Applications ({kit.resolvedTools.length})
            </span>
            <div class="space-y-1.5">
              {kit.resolvedTools.map((tool) => tool && (
                <div class="flex items-center justify-between p-2 rounded-md bg-[#0A0B0E] border border-app-border/80 text-xs">
                  <div class="flex items-center gap-2 min-w-0">
                    <a href={`/tools/${tool.slug}`} class="font-bold text-app-text hover:text-blue-400 transition-colors truncate">
                      {tool.name}
                    </a>
                    <span class="text-[10px] font-mono text-app-subtle">{tool.category}</span>
                  </div>
                  <div class="flex items-center gap-2 shrink-0">
                    <span class="font-mono text-micro text-emerald-400 font-bold">{tool.safety_score}</span>
                    <VerdictBadge verdict={tool.verdict} size="sm" />
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Card Footer Link -->
        <div class="pt-4 border-t border-app-border flex items-center justify-between font-mono text-xs">
          <span class="text-micro text-app-subtle">{kit.target_audience ? 'Homelab Certified' : 'Verified Stack'}</span>
          <a
            href={`/starter-kits#${kit.slug}`}
            class="text-blue-400 hover:text-blue-300 font-semibold inline-flex items-center gap-1"
          >
            <span>Deploy blueprint</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    ))}
  </div>
</section>

