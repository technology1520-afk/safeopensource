---
import { getLicenseInfo } from '../utils/licenses';

interface Props {
  spdx: string;
  class?: string;
}

const { spdx, class: className = '' } = Astro.props;
const info = getLicenseInfo(spdx);

const statusConfig = {
  yes: {
    label: 'Yes, fully commercial-friendly',
    badgeClass: 'text-emerald-400 border-emerald-500/30 bg-emerald-950/40',
    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'
  },
  conditional: {
    label: 'Yes, with standard conditions',
    badgeClass: 'text-amber-400 border-amber-500/30 bg-amber-950/40',
    icon: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z'
  },
  'network-clause': {
    label: 'Yes, but mind network copyleft',
    badgeClass: 'text-amber-400 border-amber-500/30 bg-amber-950/40',
    icon: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
  },
  warn: {
    label: 'Caution / Review license terms',
    badgeClass: 'text-rose-400 border-rose-500/30 bg-rose-950/40',
    icon: 'M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
  }
}[info.canCommercialUse];
---

<div class={`rounded-xl border border-app-border bg-app-surface p-5 sm:p-6 ${className}`}>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
    <div>
      <div class="text-micro text-app-subtle mb-1">Commercial Compliance</div>
      <h3 class="text-base font-semibold text-app-text flex items-center gap-2">
        <span>Can I use this commercially?</span>
      </h3>
    </div>
    <div>
      <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full border text-xs font-mono font-medium ${statusConfig.badgeClass}`}>
        <svg class="w-3.5 h-3.5 shrink-0 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d={statusConfig.icon} />
        </svg>
        <span>{statusConfig.label}</span>
      </span>
    </div>
  </div>

  <p class="text-xs sm:text-sm text-app-text leading-relaxed mb-4">
    {info.summary}
  </p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-3 border-t border-app-border text-xs">
    <div>
      <span class="text-micro text-app-subtle block mb-1.5">Permitted Rights</span>
      <ul class="space-y-1 text-app-muted">
        {info.permissions.map((perm) => (
          <li class="flex items-center gap-1.5">
            <span class="text-emerald-400 font-mono">✓</span>
            <span>{perm}</span>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <span class="text-micro text-app-subtle block mb-1.5">Key Obligations & Notes</span>
      <ul class="space-y-1 text-app-muted">
        {info.obligations.map((obl) => (
          <li class="flex items-start gap-1.5">
            <span class="text-amber-400 font-mono mt-0.5">•</span>
            <span>{obl}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="mt-4 pt-3 border-t border-app-border flex items-center justify-between text-[11px] font-mono text-app-subtle">
    <span>SPDX Identifier: <strong class="text-app-text">{info.spdx}</strong></span>
    <span>{info.name}</span>
  </div>
</div>

