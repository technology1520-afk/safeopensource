---
import type { Verdict } from '../types/tool';

interface Props {
  verdict: Verdict;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { verdict, size = 'md', class: className = '' } = Astro.props;

const config = {
  healthy: {
    label: 'Healthy',
    themeClass: 'verdict-badge-healthy',
    iconName: 'shield-check',
    paths: [
      'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z',
      'm9 12 2 2 4-4'
    ]
  },
  caution: {
    label: 'Caution',
    themeClass: 'verdict-badge-caution',
    iconName: 'triangle-alert',
    paths: [
      'm21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3',
      'M12 9v4',
      'M12 17h.01'
    ]
  },
  risky: {
    label: 'Risky',
    themeClass: 'verdict-badge-risky',
    iconName: 'octagon-x',
    paths: [
      'M7.86 2h8.28L22 7.86v8.28L16.14 22H7.86L2 16.14V7.86z',
      'm15 9-6 6',
      'm9 9 6 6'
    ]
  }
}[verdict];

const sizeClasses = {
  sm: 'text-xs px-2.5 py-0.5 gap-1',
  md: 'text-xs px-3 py-1 gap-1.5',
  lg: 'text-sm px-3.5 py-1.5 gap-2'
}[size];

const iconSize = {
  sm: 'w-3.5 h-3.5',
  md: 'w-4 h-4',
  lg: 'w-4.5 h-4.5'
}[size];
---

<span
  class={`inline-flex items-center font-mono font-medium rounded-full border ${config.themeClass} ${sizeClasses} ${className}`}
  role="status"
  data-verdict-icon={config.iconName}
  aria-label={`Safety verdict: ${config.label}`}
>
  <svg
    class={`${iconSize} shrink-0 stroke-current`}
    viewBox="0 0 24 24"
    fill="none"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    {config.paths.map((d) => <path d={d} />)}
  </svg>
  <span>{config.label}</span>
</span>

