---
interface UseCase {
  title: string;
  description: string;
  icon?: string;
}

interface Props {
  useCases: UseCase[];
  class?: string;
}

const { useCases, class: className = '' } = Astro.props;
---

<div class={`space-y-3 ${className}`}>
  <p class="text-xs text-app-muted leading-relaxed mb-4">
    Primary real-world deployment workloads verified for this application architecture:
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    {useCases.map((uc) => (
      <div class="p-3.5 rounded-xl border border-app-border bg-app-bg flex items-start gap-3">
        <div class="w-7 h-7 rounded-lg bg-blue-950/50 border border-blue-500/30 flex items-center justify-center shrink-0 text-blue-400 mt-0.5">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 11 12 14 22 4" />
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
          </svg>
        </div>
        <div>
          <h4 class="text-xs font-bold text-app-text mb-1">{uc.title}</h4>
          <p class="text-[11px] text-app-muted leading-relaxed">{uc.description}</p>
        </div>
      </div>
    ))}
  </div>
</div>

