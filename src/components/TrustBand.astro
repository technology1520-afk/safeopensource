---
interface Props {
  scoped?: boolean;
  repo?: string;
  scorecard?: number | null;
  license?: string;
  class?: string;
}

const {
  scoped = false,
  repo,
  scorecard,
  license,
  class: className = ''
} = Astro.props;
---

{scoped ? (
  <div class={`w-full rounded-xl border border-app-border/80 bg-[#0c0d12] px-4 py-3 font-mono text-xs text-app-subtle ${className}`}>
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
      <div class="flex items-center gap-2 min-w-0">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>
        <span class="text-app-text font-medium truncate">
          Scanned from <a href={`https://github.com/${repo}`} target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:underline">github.com/{repo}</a>
        </span>
      </div>

      <div class="flex flex-wrap items-center gap-3 sm:gap-5 text-app-subtle text-[11px] sm:text-xs">
        <span>
          OpenSSF Scorecard: <strong class="text-emerald-400 font-semibold">{scorecard ? `${scorecard}/10 (v4)` : 'Direct Telemetry'}</strong>
        </span>
        <span class="text-app-border">|</span>
        <span>
          License: <strong class="text-app-text font-semibold">{license} verified</strong>
        </span>
        <span class="text-app-border">|</span>
        <a href="/how-we-score" class="text-blue-400 hover:text-blue-300 transition-colors inline-flex items-center gap-1">
          <span>Audit Methodology</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>
  </div>
) : (
  <div class={`w-full rounded-xl border border-app-border/70 bg-[#0d0f14] px-4 py-3 font-mono text-xs text-app-subtle ${className}`}>
    <div class="flex flex-wrap items-center justify-center sm:justify-between gap-x-6 gap-y-2 text-center sm:text-left text-[11px] sm:text-xs">
      <div class="flex items-center justify-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
        <span class="text-app-text font-medium tracking-tight">
          39 Repos Under Continuous Telemetry Watch
        </span>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-4">
        <span>
          Scores via <a href="https://scorecard.dev" target="_blank" rel="noopener noreferrer" class="text-app-text hover:text-blue-400 underline decoration-app-border transition-colors">OpenSSF Scorecard</a>
        </span>
        <span class="text-app-border hidden sm:inline">&middot;</span>
        <span>
          Refreshed weekly from <a href="https://www.githubstatus.com" target="_blank" rel="noopener noreferrer" class="text-app-text hover:text-blue-400 underline decoration-app-border transition-colors">GitHub API</a>
        </span>
        <span class="text-app-border hidden sm:inline">&middot;</span>
        <span>
          Commit <code class="text-emerald-400/90 font-bold bg-[#131519] px-1.5 py-0.5 rounded border border-app-border">#soc-v2.4</code>
        </span>
        <span class="text-app-border hidden sm:inline">&middot;</span>
        <a href="/how-we-score" class="text-blue-400 hover:underline font-semibold">
          Public Methodology &rarr;
        </a>
      </div>
    </div>
  </div>
)}

